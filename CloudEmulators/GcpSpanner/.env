# Google Cloud Spanner emulator (official emulator image)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
SPANNER_EMULATOR_VERSION=1.5.59

# --- Host ports ---
# gRPC (client libraries). 9010 (the emulator default) is used by Portainer.
SPANNER_GRPC_PORT=9011
# REST (gcloud, HTTP clients)
SPANNER_REST_PORT=9020

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
SPANNER_EMULATOR_IP=172.20.3.90
