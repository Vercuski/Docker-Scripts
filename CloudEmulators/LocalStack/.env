# LocalStack for AWS (official image; requires a LocalStack account and auth token since 2026.03)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Calendar versions (YYYY.MM). 4.14 is the last release that starts without a token, but it no longer gets updates.
LOCALSTACK_VERSION=2026.10

# --- Host ports ---
# Edge port for all services (4566 is used by CloudEmulators/Floci)
LOCALSTACK_PORT=4567

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
LOCALSTACK_IP=172.20.3.60

# --- Credentials & settings ---
# Required: your personal auth token from https://app.localstack.cloud (Settings > Auth Tokens).
# The free tier is for non-commercial use. LocalStack exits at startup when this is empty.
LOCALSTACK_AUTH_TOKEN=
# 1 = save state to the data folder and restore it on start (if your plan includes persistence)
LOCALSTACK_PERSISTENCE=0
LOCALSTACK_DEBUG=0
