# Azure Service Bus emulator (uses the MSSQL stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
SERVICEBUS_EMULATOR_VERSION=latest

# --- Host ports ---
SERVICEBUS_AMQP_PORT=5673
SERVICEBUS_HTTP_PORT=5300

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
SERVICEBUS_EMULATOR_IP=192.168.16.101

# --- Credentials & settings ---
# Accepts the emulator license: https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
SERVICEBUS_ACCEPT_EULA=Y
# SQL Server host on GroupNetwork (the MSSQL stack alias)
SERVICEBUS_SQL_SERVER=mssqldb
# Must match MSSQL_SA_PASSWORD in Databases/MSSQL/.env
SERVICEBUS_SQL_SA_PASSWORD=Password123
