# Azure Event Hubs emulator (uses the Azurite stack for checkpoints and metadata)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
EVENTHUBS_EMULATOR_VERSION=2.2.1

# --- Host ports ---
# AMQP (5672 is used by RabbitMQ, 5673 by the Service Bus emulator)
EVENTHUBS_AMQP_PORT=5674
# Kafka protocol (9092 is used by the Kafka stack, 9093 by Alertmanager)
EVENTHUBS_KAFKA_PORT=9094
# Health / management (5300 is used by the Service Bus emulator)
EVENTHUBS_HTTP_PORT=5301

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
EVENTHUBS_EMULATOR_IP=172.20.3.40

# --- Credentials & settings ---
# Accepts the emulator license: https://github.com/Azure/azure-event-hubs-emulator-installer/blob/main/EMULATOR_EULA.txt
EVENTHUBS_ACCEPT_EULA=Y
# Azure Storage on GroupNetwork (the Azurite stack alias), used for checkpoints and metadata
EVENTHUBS_STORAGE_HOST=azurite
