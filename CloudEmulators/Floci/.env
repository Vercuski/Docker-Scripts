# Floci (open-source AWS emulator, LocalStack-compatible, no account or auth token)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
FLOCI_VERSION=2.5.0

# --- Host ports ---
# All AWS services (the same port LocalStack uses; CloudEmulators/LocalStack is on 4567)
FLOCI_PORT=4566

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
FLOCI_IP=172.20.3.50

# --- Credentials & settings ---
FLOCI_DEFAULT_REGION=us-east-1
FLOCI_DEFAULT_ACCOUNT_ID=000000000000
# memory (nothing kept) | hybrid (in memory, flushed to disk every 5 s) | persistent | wal
FLOCI_STORAGE_MODE=hybrid
