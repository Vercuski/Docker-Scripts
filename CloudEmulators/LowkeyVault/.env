# Lowkey Vault (community Azure Key Vault emulator: secrets, keys, certificates)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
LOWKEY_VAULT_VERSION=7.4.0

# --- Host ports ---
# Key Vault API over HTTPS (8443 is used by Nginx UI)
LOWKEY_VAULT_PORT=8446
# Simulated managed identity token endpoint and metadata over HTTP
LOWKEY_VAULT_METADATA_PORT=8097

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
LOWKEY_VAULT_IP=172.20.3.100

# --- Credentials & settings ---
# Extra Lowkey Vault startup arguments, e.g. --LOWKEY_DEBUG_REQUEST_LOG=true
LOWKEY_VAULT_EXTRA_ARGS=
