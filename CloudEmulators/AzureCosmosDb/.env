# Azure Cosmos DB emulator (Linux vNext, NoSQL API)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
COSMOSDB_EMULATOR_VERSION=vnext-latest

# --- Host ports ---
# Leave at 8081 - the Data Explorer ignores other host ports
COSMOSDB_PORT=8081
COSMOSDB_EXPLORER_PORT=1234

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
COSMOSDB_EMULATOR_IP=192.168.16.102

# --- Credentials & settings ---
# http | https - the .NET SDK requires https
COSMOSDB_PROTOCOL=https
COSMOSDB_ENABLE_EXPLORER=true
COSMOSDB_EXPLORER_PROTOCOL=http
COSMOSDB_LOG_LEVEL=info
