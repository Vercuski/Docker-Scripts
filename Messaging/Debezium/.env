# Debezium on Kafka Connect (change data capture from PostgreSQL, SQL Server, MySQL, MongoDB, ... into the Kafka stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
DEBEZIUM_VERSION=3.7

# --- Host ports ---
# Kafka Connect REST API (8083 is used by Apache httpd)
DEBEZIUM_PORT=8118

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
DEBEZIUM_IP=172.20.10.80

# --- Credentials & settings ---
# Connect cluster id and its internal topics in the Kafka stack
DEBEZIUM_GROUP_ID=debezium
DEBEZIUM_CONFIG_TOPIC=debezium_connect_configs
DEBEZIUM_OFFSET_TOPIC=debezium_connect_offsets
DEBEZIUM_STATUS_TOPIC=debezium_connect_statuses

# --- Tuning ---
DEBEZIUM_HEAP_OPTS=-Xms256m -Xmx1g
