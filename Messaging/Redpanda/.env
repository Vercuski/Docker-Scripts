# Redpanda (Kafka-API compatible streaming platform in C++, no JVM/ZooKeeper) + Redpanda Console
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
REDPANDA_VERSION=v26.2.7
REDPANDA_CONSOLE_VERSION=v3.14.0

# --- Host ports ---
# Kafka API (9092 is used by the Kafka stack)
REDPANDA_KAFKA_PORT=19092
# Built-in Schema Registry (Confluent-compatible API)
REDPANDA_SCHEMA_REGISTRY_PORT=18081
# HTTP Proxy (pandaproxy)
REDPANDA_HTTP_PROXY_PORT=18082
# Admin API (rpk, metrics at /public_metrics)
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8116

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
REDPANDA_IP=172.20.10.60
REDPANDA_CONSOLE_IP=172.20.10.61

# --- Tuning ---
REDPANDA_SMP=1
REDPANDA_MEMORY=1G
