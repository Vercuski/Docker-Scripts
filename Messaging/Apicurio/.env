# Apicurio Registry 3 (schema & API registry: Avro, Protobuf, JSON Schema, OpenAPI, AsyncAPI) - storage in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
APICURIO_VERSION=3.3.4
# Client image for the one-shot database setup (only psql is used)
APICURIO_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# REST API: /apis/registry/v3 and the Confluent-compatible /apis/ccompat/v7
APICURIO_API_PORT=8119
APICURIO_UI_PORT=8120

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
APICURIO_DB_INIT_IP=172.20.10.90
APICURIO_IP=172.20.10.91
APICURIO_UI_IP=172.20.10.92

# --- Credentials & settings ---
# PostgreSQL stack superuser (used once to create the role and database)
APICURIO_DB_ADMIN_USER=user@user.com
APICURIO_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
APICURIO_DB_NAME=apicurio
APICURIO_DB_USER=apicurio
APICURIO_DB_PASSWORD=Password123
