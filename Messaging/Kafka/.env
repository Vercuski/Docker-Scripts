# Kafka (KRaft, single node) + Kafka UI
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
KAFKA_VERSION=4.1.0
KAFKA_UI_VERSION=latest

# --- Host ports ---
# Host bootstrap port - also used in the advertised EXTERNAL listener
KAFKA_PORT=9092
KAFKA_UI_PORT=8084

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
KAFKA_IP=192.168.16.70
KAFKA_UI_IP=192.168.16.73

# --- Credentials & settings ---
# 22-char base64 UUID - keep it fixed so the data folder stays valid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_UI_CLUSTER_NAME=local
