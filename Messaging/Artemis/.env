# Apache Artemis (formerly ActiveMQ Artemis) - JMS / AMQP 1.0 / STOMP / MQTT / OpenWire broker
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
ARTEMIS_VERSION=2.57.0

# --- Host ports ---
# Core, OpenWire, AMQP, STOMP, MQTT and HornetQ are all accepted on 61616
ARTEMIS_PORT=61616
# Dedicated AMQP 1.0 port (5672 is RabbitMQ, 5673/5674 the Azure emulators)
ARTEMIS_AMQP_PORT=5675
ARTEMIS_STOMP_PORT=61613
# Web console + Jolokia
ARTEMIS_CONSOLE_PORT=8161

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
ARTEMIS_IP=172.20.10.50

# --- Credentials & settings ---
# Created with the broker instance on the first start only
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=Password123

# --- Tuning ---
# Block producers when disk usage exceeds this percent (-1 = never)
ARTEMIS_MAX_DISK_USAGE=-1
