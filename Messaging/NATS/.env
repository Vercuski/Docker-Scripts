# NATS with JetStream (lightweight pub/sub, request/reply, persistent streams, key/value and object store)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
NATS_VERSION=2.15.3-alpine

# --- Host ports ---
NATS_CLIENT_PORT=4222
# HTTP monitoring endpoints (/varz, /connz, /jsz)
NATS_MONITOR_PORT=8222

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
NATS_IP=172.20.10.30

# --- Credentials & settings ---
NATS_USER=nats
NATS_PASSWORD=Password123

# --- Tuning ---
# JetStream storage limits
NATS_JS_MAX_MEMORY=256M
NATS_JS_MAX_FILE=5G
