# RabbitMQ
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Use a *-management* tag to keep the web UI
RABBITMQ_VERSION=management-alpine

# --- Host ports ---
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_METRICS_PORT=15692

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
RABBITMQ_IP=192.168.16.72

# --- Credentials & settings ---
# Default user - only applied when the data folder is empty
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
