# code-server - standalone browser IDE with the .NET SDK (image built from ./image)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Base image tag (codercom/code-server) and the .NET SDK channel installed on top; rebuild with: docker compose build
CODE_SERVER_VERSION=4.145.2
CODE_SERVER_DOTNET_CHANNEL=10.0

# --- Host ports ---
CODE_SERVER_PORT=8159
# Spare port for an app you run inside the IDE
CODE_SERVER_APP_PORT=5080

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
CODE_SERVER_IP=172.20.30.50

# --- Credentials & settings ---
CODE_SERVER_PASSWORD=Password123
CODE_SERVER_TZ=America/New_York
