# Homarr - standalone dashboard (SQLite in the appdata folder)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
HOMARR_VERSION=v2.13.1

# --- Host ports ---
HOMARR_PORT=7575

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
HOMARR_IP=172.20.30.20
HOMARR_INIT_IP=172.20.30.21

# --- Credentials & settings ---
# Admin created by homarr-init on an empty database (later changes: UI > Manage > Users)
HOMARR_ADMIN_USER=admin
HOMARR_ADMIN_PASSWORD=Password123
# 64 hex characters (openssl rand -hex 32); encrypts integration secrets - don't change it once data exists
HOMARR_SECRET_ENCRYPTION_KEY=0d1b7b1c5c2e4f6a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a
HOMARR_TZ=America/New_York
