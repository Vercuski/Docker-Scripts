# Apache Superset (BI: SQL Lab, charts, dashboards) - metadata database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
# Base image for ./image/Dockerfile (adds PostgreSQL, SQL Server and MySQL drivers)
SUPERSET_VERSION=6.1.0
# Client image for the one-shot database setup (only psql is used)
SUPERSET_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# Web UI + API (8088 is mongo-express)
SUPERSET_PORT=8142

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
SUPERSET_DB_INIT_IP=172.20.20.30
SUPERSET_INIT_IP=172.20.20.31
SUPERSET_IP=172.20.20.32

# --- Credentials & settings ---
# Administrator created (or password reset) by superset-init on every start
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=Password123
SUPERSET_ADMIN_EMAIL=admin@example.com
# Signs sessions and encrypts stored database passwords. Keep it once set.
SUPERSET_SECRET_KEY=KEJqz48ky1PwpQQbbvSFpIUR/8ws2IPZedDWyw2lYu3MMRH+A4KXl+hz
# PostgreSQL stack superuser (used once to create the role and database)
SUPERSET_DB_ADMIN_USER=user@user.com
SUPERSET_DB_ADMIN_PASSWORD=Password123
# Dedicated metadata database and role
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=Password123
