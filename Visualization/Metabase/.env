# Metabase (BI: questions, dashboards, SQL editor) - application database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
METABASE_VERSION=v0.65.4.5
# Client image for the one-shot database setup (only psql is used)
METABASE_DB_INIT_IMAGE=postgres:18
# Small image with curl for the one-shot admin setup
METABASE_CURL_IMAGE=curlimages/curl:8.23.0

# --- Host ports ---
# Web UI + API (3000 is Grafana)
METABASE_PORT=3008

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
METABASE_DB_INIT_IP=172.20.20.20
METABASE_IP=172.20.20.21
METABASE_INIT_IP=172.20.20.22

# --- Credentials & settings ---
# Administrator created by metabase-init on the first start (Metabase's setup page)
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=Password123
METABASE_SITE_NAME=Local Dev
# Password policy: weak, normal or strong ("normal" rejects common passwords such as Password123)
METABASE_PASSWORD_COMPLEXITY=weak
# Encrypts database connection details stored by Metabase (at least 16 characters). Keep it once set.
METABASE_ENCRYPTION_KEY=AcyH5snDujSYfDHYY6tRidDpZfjVhRcw
# PostgreSQL stack superuser (used once to create the role and database)
METABASE_DB_ADMIN_USER=user@user.com
METABASE_DB_ADMIN_PASSWORD=Password123
# Dedicated application database and role
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=Password123

# --- Tuning ---
METABASE_JAVA_HEAP=1g
