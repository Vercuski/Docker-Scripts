# HashiCorp Nomad (workload orchestrator), single node, running jobs as containers on this Docker host
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
NOMAD_VERSION=2.1.1

# --- Host ports ---
# HTTP API + web UI
NOMAD_PORT=4646

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
NOMAD_IP=172.20.12.60

# --- Credentials & settings ---
# Nomad state and allocation folders. Must be an absolute Linux path that is the SAME inside the container and on the
# Docker host (on Docker Desktop: a path inside its Linux VM). Not under ROOT_VOLUME_DIR for that reason; on Docker
# Desktop it is lost when the VM is reset.
NOMAD_DATA_DIR=/var/lib/nomad-docker
