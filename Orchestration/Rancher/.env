# Rancher (single-container dev install)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
RANCHER_VERSION=latest

# --- Host ports ---
RANCHER_HTTP_PORT=8480
RANCHER_HTTPS_PORT=8444

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
RANCHER_IP=192.168.16.91
