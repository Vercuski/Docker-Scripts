# K3s (single-node Kubernetes in a container) + Argo CD, installed automatically by k3s-setup
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
K3S_VERSION=v1.37.2-k3s1
# Argo CD release whose install manifest k3s-setup applies
ARGOCD_VERSION=v3.6.1

# --- Host ports ---
# Kubernetes API (the container listens on the same port, so the generated kubeconfig works from the host)
K3S_API_PORT=6443
# Argo CD UI / API (plain HTTP)
ARGOCD_PORT=8124

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
K3S_IP=172.20.12.40
K3S_SETUP_IP=172.20.12.41

# --- Credentials & settings ---
# Argo CD "admin" password is set to Password123 by k3s-setup (bcrypt hash in docker-compose.yml)
# GroupNetwork services that pods inside the cluster can reach by name (name=IP, space separated)
K3S_GROUPNETWORK_HOSTS=gitea=172.20.19.10 postgresql=172.20.6.130 mssqldb=172.20.6.90 redis=172.20.6.150 kafka=172.20.10.10 rabbitmq=172.20.10.20 keycloak=172.20.2.10 dockerregistry=172.20.5.10
