# Apache NiFi 2 (single node, single-user login)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
NIFI_VERSION=2.12.0

# --- Host ports ---
# UI + REST API (HTTPS)
NIFI_PORT=8155

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
NIFI_IP=172.20.28.10
NIFI_INIT_IP=172.20.28.11

# --- Credentials & settings ---
# Single-user login; NiFi requires a password of at least 12 characters (hence the "!")
NIFI_ADMIN_USER=admin
NIFI_ADMIN_PASSWORD=Password123!
# Encrypts sensitive properties stored in the flow (12+ characters) - keep it once flows exist
NIFI_SENSITIVE_PROPS_KEY=local-dev-nifi-sensitive-key

# --- Tuning ---
# JVM heap (initial = max)
NIFI_JVM_HEAP=1g
