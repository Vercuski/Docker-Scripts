# Airbyte (community) installed into the Orchestration/K3s cluster with Helm; database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Airbyte Helm chart (chart version = Airbyte version); "docker compose up airbyte-install" upgrades in place
AIRBYTE_CHART_VERSION=2.5.0
AIRBYTE_HELM_VERSION=4.3.2
AIRBYTE_SOCAT_VERSION=1.8.1.3
# Client image for the one-shot database setup (only psql is used)
AIRBYTE_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# UI + API (also in values.yaml as global.airbyteUrl - change both)
AIRBYTE_PORT=8154

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
AIRBYTE_DB_INIT_IP=172.20.28.20
AIRBYTE_INSTALL_IP=172.20.28.21
AIRBYTE_PROXY_IP=172.20.28.22

# --- Credentials & settings ---
# UI login password (email is entered on the first visit)
AIRBYTE_ADMIN_PASSWORD=Password123
# PostgreSQL stack superuser (used once to create the role and database)
AIRBYTE_DB_ADMIN_USER=user@user.com
AIRBYTE_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role (name/user also in values.yaml)
AIRBYTE_DB_NAME=airbyte
AIRBYTE_DB_USER=airbyte
AIRBYTE_DB_PASSWORD=Password123
