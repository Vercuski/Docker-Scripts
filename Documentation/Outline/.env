# Outline (Notion-style team wiki) + Redis + Dex (bundled OIDC login) - database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
OUTLINE_VERSION=1.13.0
OUTLINE_REDIS_VERSION=8-alpine
DEX_VERSION=v2.41.1
# Client image for the one-shot database setup (only psql is used)
OUTLINE_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# 3000 Grafana, 3001 Gitea, 3003 Wiki.js
OUTLINE_PORT=3002
# Dex login page (the browser is redirected here, so the container listens on the same port)
DEX_PORT=5556

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
OUTLINE_DB_INIT_IP=172.20.7.50
OUTLINE_REDIS_IP=172.20.7.51
OUTLINE_DEX_IP=172.20.7.52
OUTLINE_IP=172.20.7.53

# --- Credentials & settings ---
# Login (Dex): admin@example.com / Password123 - users are defined in dex.yaml
# Shared secret between Outline and Dex
OUTLINE_OIDC_CLIENT_SECRET=Password123
# Outline secrets (64 hex chars each). Keep SECRET_KEY once data exists: it encrypts stored secrets.
OUTLINE_SECRET_KEY=01f8acc6f602a1fb3e60a80312359af6e09606e84e3efd79161258072280de3b
OUTLINE_UTILS_SECRET=fe4166293444fb2efdc448d7c4cf2ab407a2cd5961f6c880c35110996ad18842
# PostgreSQL stack superuser (used once to create the role and database)
OUTLINE_DB_ADMIN_USER=user@user.com
OUTLINE_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
OUTLINE_DB_NAME=outline
OUTLINE_DB_USER=outline
OUTLINE_DB_PASSWORD=Password123

# --- Tuning ---
# Largest attachment in bytes (default 25 MB)
OUTLINE_UPLOAD_MAX_SIZE=26214400
