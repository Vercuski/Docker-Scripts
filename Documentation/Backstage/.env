# Backstage (uses the PostgreSQL stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Locally built image (see ReadMe.md)
BACKSTAGE_IMAGE=backstage

# --- Host ports ---
BACKSTAGE_PORT=7007

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
BACKSTAGE_IP=192.168.16.30

# --- Credentials & settings ---
BACKSTAGE_POSTGRES_HOST=postgresql
BACKSTAGE_POSTGRES_PORT=5432
BACKSTAGE_POSTGRES_USER=user@user.com
BACKSTAGE_POSTGRES_PASSWORD=Password123
