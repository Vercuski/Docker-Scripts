# API documentation viewers: Swagger UI (try-it-out console) and Redoc (reference docs) for OpenAPI specs
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
SWAGGER_UI_VERSION=v5.35.0
REDOC_VERSION=3.1.0

# --- Host ports ---
SWAGGER_UI_PORT=8113
REDOC_PORT=8114

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
SWAGGER_UI_IP=172.20.7.90
REDOC_IP=172.20.7.91

# --- Credentials & settings ---
# Specs are fetched by the BROWSER, so localhost URLs of apps running on your machine work (the app must allow CORS).
# Relative URLs point at the ./specs folder of this stack.
# Swagger UI: JSON list shown in the "Select a definition" dropdown
API_SPEC_URLS=[{"url":"specs/sample-todo-api.yaml","name":"Sample Todo API (./specs)"},{"url":"http://localhost:5000/openapi/v1.json","name":"Local ASP.NET app (:5000)"}]
# Redoc: a single spec
API_SPEC_URL=specs/sample-todo-api.yaml
