# draw.io / diagrams.net (self-hosted diagram editor; diagrams are saved to your computer, not the server)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
DRAWIO_VERSION=32.6.10

# --- Host ports ---
DRAWIO_PORT=8111

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
DRAWIO_IP=172.20.7.80
