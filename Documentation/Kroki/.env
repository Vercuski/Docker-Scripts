# Kroki (diagrams-as-code rendering API: PlantUML, C4, Mermaid, BPMN, Excalidraw, Graphviz, D2 and more)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
KROKI_VERSION=0.36.0

# --- Host ports ---
KROKI_PORT=8000

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
KROKI_IP=172.20.7.70
KROKI_MERMAID_IP=172.20.7.71
KROKI_BPMN_IP=172.20.7.72
KROKI_EXCALIDRAW_IP=172.20.7.73

# --- Tuning ---
# Largest diagram source accepted, in bytes
KROKI_MAX_BODY=1048576
