# BookStack (wiki organised as shelves > books > chapters > pages) - database in the MariaDB stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
BOOKSTACK_VERSION=26.09.3
# Client image for the one-shot database setup (only the mariadb client is used)
BOOKSTACK_DB_INIT_IMAGE=mariadb:11

# --- Host ports ---
BOOKSTACK_PORT=6875

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
BOOKSTACK_DB_INIT_IP=172.20.7.40
BOOKSTACK_IP=172.20.7.41

# --- Credentials & settings ---
# Default login on a new database: admin@admin.com / password (change it after the first login)
# Laravel encryption key ("base64:" + 32 random bytes). Keep it once data exists.
BOOKSTACK_APP_KEY=base64:bG9jYWwtZGV2LWJvb2tzdGFjay1hcHAta2V5LTAwMDE=
# MariaDB stack root (used once to create the user and database)
BOOKSTACK_DB_ADMIN_PASSWORD=Password123
# Dedicated database and user
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=Password123
