# ProGet (uses the MSSQL stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
PROGET_VERSION=24.0.2

# --- Host ports ---
PROGET_HTTP_PORT=8091
PROGET_HTTPS_PORT=8092

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
PROGET_IP=192.168.16.200

# --- Credentials & settings ---
PROGET_SQL_CONNECTION_STRING='Data Source=mssqldb;Initial Catalog=Proget;User ID=Proget;Password=Password123;TrustServerCertificate=True'
PROGET_ASPNETCORE_URLS=http://*:80;https://*:443
PROGET_SSL_CERT_FILE=proget.cer
