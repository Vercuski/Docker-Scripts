# BaGetter (lightweight NuGet + symbol server written in .NET, the maintained fork of BaGet)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
BAGETTER_VERSION=1.6.5

# --- Host ports ---
BAGETTER_PORT=5555

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
BAGETTER_IP=172.20.13.30

# --- Credentials & settings ---
# Required to push / delete packages (dotnet nuget push -k ...)
BAGETTER_API_KEY=Password123
# Proxy and cache packages from nuget.org that are not found locally
BAGETTER_MIRROR_ENABLED=true
