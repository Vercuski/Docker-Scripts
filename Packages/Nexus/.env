# Sonatype Nexus Repository Community Edition (NuGet, npm, Docker, Maven, PyPI, Helm, raw ... hosted, proxy and group repos)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
NEXUS_VERSION=3.98.1

# --- Host ports ---
# Web UI + all repository endpoints (8081 is used by the Cosmos DB emulator)
NEXUS_PORT=8125

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
NEXUS_IP=172.20.13.20
NEXUS_INIT_IP=172.20.13.21

# --- Credentials & settings ---
# Initial "admin" password, applied on the first start only (change it in the UI afterwards)
NEXUS_ADMIN_PASSWORD=Password123
# true = nexus-init accepts the Community Edition EULA (https://links.sonatype.com/products/nxrm/ce-eula) and acknowledges
# its mandatory telemetry for you; false = accept it yourself in the first-login wizard (uploads fail until then)
NEXUS_ACCEPT_EULA=true

# --- Tuning ---
NEXUS_JVM_OPTS=-Xms1g -Xmx2g -XX:MaxDirectMemorySize=2g
