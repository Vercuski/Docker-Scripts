# Apache Spark (standalone master + worker)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
SPARK_VERSION=latest

# --- Host ports ---
# Master web UI
SPARK_UI_PORT=8090
# Master RPC (spark://localhost:<port>)
SPARK_MASTER_PORT=7077

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
SPARK_MASTER_IP=192.168.16.190
SPARK_WORKER_IP=192.168.16.192

# --- Tuning ---
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
