# Trino (single node: coordinator + worker in one container)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Trino releases are numbered (no major/minor); pin one so catalog properties don't change underneath you
TRINO_VERSION=484

# --- Host ports ---
# Web UI + client protocol (8080 is used by CockroachDB)
TRINO_PORT=8094

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
TRINO_IP=172.20.1.40

# --- Credentials & settings ---
# Logins for the database stacks the catalogs in etc/catalog connect to.
# They must match the .env of each database stack.
TRINO_POSTGRES_USER=user@user.com
TRINO_POSTGRES_PASSWORD=Password123
TRINO_POSTGRES_DATABASE=postgres
TRINO_MSSQL_USER=sa
TRINO_MSSQL_PASSWORD=Password123
TRINO_MSSQL_DATABASE=master
TRINO_MYSQL_USER=root
TRINO_MYSQL_PASSWORD=Password123
TRINO_MONGO_USER=user
TRINO_MONGO_PASSWORD=Password123
TRINO_CLICKHOUSE_USER=admin
TRINO_CLICKHOUSE_PASSWORD=Password123
# Cassandra's default data center name
TRINO_CASSANDRA_DC=datacenter1

# --- Tuning ---
# The JVM heap is 80% of this limit
TRINO_MEM_LIMIT=4g
