# Apache Flink (session cluster: JobManager + TaskManager)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Pinned to a minor version: Flink config keys and savepoint compatibility change between releases
FLINK_VERSION=2.3

# --- Host ports ---
# Web UI + REST API (8081 is used by the Cosmos DB emulator)
FLINK_UI_PORT=8093

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
FLINK_JOBMANAGER_IP=172.20.1.30
FLINK_TASKMANAGER_IP=172.20.1.31

# --- Tuning ---
FLINK_TASK_SLOTS=4
FLINK_PARALLELISM=1
FLINK_JOBMANAGER_MEMORY=1600m
FLINK_TASKMANAGER_MEMORY=1728m
