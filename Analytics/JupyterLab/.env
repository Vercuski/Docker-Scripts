# JupyterLab (Jupyter pyspark-notebook image: Python, pandas, PySpark)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# quay.io/jupyter/pyspark-notebook tag. Keep the Spark version equal to the Analytics/Apache Spark
# stack (spark:latest is 4.3.0 today) so notebooks can submit jobs to that cluster.
JUPYTERLAB_VERSION=spark-4.3.0

# --- Host ports ---
JUPYTERLAB_PORT=8888
# Spark UI of a notebook's running Spark session
JUPYTERLAB_SPARK_UI_PORT=4040

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
JUPYTERLAB_IP=172.20.1.50

# --- Credentials & settings ---
# Login token for the web UI
JUPYTERLAB_TOKEN=Password123
