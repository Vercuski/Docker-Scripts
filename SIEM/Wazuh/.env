# Wazuh SIEM (manager + indexer + dashboard, single node)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Manager, indexer and dashboard must all be the same Wazuh version
WAZUH_VERSION=4.14.8
WAZUH_CERTS_GENERATOR_VERSION=0.0.4
# Major.minor of the wazuh-certs-tool.sh the generator downloads (match WAZUH_VERSION)
WAZUH_CERT_TOOL_VERSION=4.14

# --- Host ports ---
# Dashboard web UI (HTTPS) - 443 is taken by Nginx Proxy Manager, 5601/5602 by Kibana/OpenSearch Dashboards
WAZUH_DASHBOARD_PORT=5603
# Indexer REST API (HTTPS) - 9200/9201 are taken by Elasticsearch/OpenSearch
WAZUH_INDEXER_PORT=9202
# Agent connection, agent enrollment, syslog (UDP) and server API
WAZUH_AGENT_PORT=1514
WAZUH_ENROLLMENT_PORT=1515
WAZUH_SYSLOG_PORT=514
WAZUH_API_PORT=55000

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
WAZUH_CERTS_IP=172.20.18.10
WAZUH_MANAGER_IP=172.20.18.11
WAZUH_INDEXER_IP=172.20.18.12
WAZUH_DASHBOARD_IP=172.20.18.13

# --- Credentials & settings ---
# Indexer users. The indexer itself authenticates against the bcrypt hashes in
# config/internal_users.yml - change a password there too (see ReadMe.md) or logins will fail.
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=SecretPassword
WAZUH_DASHBOARD_USERNAME=kibanaserver
WAZUH_DASHBOARD_PASSWORD=kibanaserver
# Wazuh server API user used by the dashboard. Must be 8-64 chars with upper, lower, digit and symbol.
# Applied on first start only (stored in the manager and dashboard config volumes afterwards).
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
TZ=America/New_York

# --- Tuning ---
# Indexer JVM heap - keep Xms = Xmx, about half the RAM you give it
WAZUH_INDEXER_JAVA_OPTS=-Xms1g -Xmx1g
WAZUH_INDEXER_NOFILE=65536
WAZUH_MANAGER_NOFILE=655360
