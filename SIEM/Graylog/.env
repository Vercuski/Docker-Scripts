# Graylog Open 7 (log management / SIEM): server + Graylog Data Node (managed OpenSearch) + its own MongoDB 8.0
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
GRAYLOG_VERSION=7.2.2
# Graylog 7.2 supports MongoDB 7.x-8.3.x (the shared MongoDB stack floats on latest, which is 9.x)
GRAYLOG_MONGO_VERSION=8.0

# --- Host ports ---
# Web UI + REST API (9000 is SonarQube)
GRAYLOG_PORT=9004
# GELF input (TCP and UDP) - Serilog.Sinks.Graylog, NLog.GelfLayout, Docker gelf log driver
GRAYLOG_GELF_PORT=12201
# Syslog input (TCP and UDP)
GRAYLOG_SYSLOG_PORT=5140
# Beats input (Filebeat, Winlogbeat)
GRAYLOG_BEATS_PORT=5044

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
GRAYLOG_MONGO_IP=172.20.18.20
GRAYLOG_DATANODE_IP=172.20.18.21
GRAYLOG_IP=172.20.18.22

# --- Credentials & settings ---
# Password of the built-in "admin" user (hashed with SHA-256 by the container on start)
GRAYLOG_ROOT_PASSWORD=Password123
# Peppers stored passwords and encrypts secrets; shared by the server and the data node (at least 64 characters).
# Changing it invalidates sessions, access tokens and encrypted values.
GRAYLOG_PASSWORD_SECRET=2c4QnchMWHJlOrpNAloUb8rJ3pnjzb6ii7qXPxAOcojTE9wZi2Cot4fGCa6KkFw0ERCXrhZouifXOqV8kgFr43M0GiUKTgVc
GRAYLOG_TIMEZONE=UTC

# --- Tuning ---
GRAYLOG_SERVER_HEAP=1g
GRAYLOG_DATANODE_HEAP=1g
