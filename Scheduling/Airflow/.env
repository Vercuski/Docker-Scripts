# Apache Airflow 3 (Python DAG scheduler) with LocalExecutor - metadata database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
AIRFLOW_VERSION=3.4.0
# Client image for the one-shot database setup (only psql is used)
AIRFLOW_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# Web UI + REST API (8080 is used by CockroachDB)
AIRFLOW_PORT=8136

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
AIRFLOW_DB_INIT_IP=172.20.15.30
AIRFLOW_INIT_IP=172.20.15.31
AIRFLOW_APISERVER_IP=172.20.15.32
AIRFLOW_SCHEDULER_IP=172.20.15.33
AIRFLOW_DAG_PROCESSOR_IP=172.20.15.34
AIRFLOW_TRIGGERER_IP=172.20.15.35

# --- Credentials & settings ---
# Web UI administrator (created or updated by airflow-init on every start)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=Password123
# PostgreSQL stack superuser (used once to create the role and database)
AIRFLOW_DB_ADMIN_USER=user@user.com
AIRFLOW_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=Password123
# Encrypts connection passwords and variables in the database. Changing it makes stored secrets unreadable.
AIRFLOW_FERNET_KEY=VDb9b6B7r2cRKV9pX6MMV14lorJBIMhlDh4cURFhoRk=
# Signs the tokens the API server issues to task processes
AIRFLOW_JWT_SECRET=local-dev-airflow-jwt-secret-change-me
# Load Airflow's ~50 example DAGs (shown paused)
AIRFLOW_LOAD_EXAMPLES=false

# --- Tuning ---
# Extra PyPI packages installed on every container start (slow; build a custom image for anything permanent)
AIRFLOW_PIP_ADDITIONAL_REQUIREMENTS=
