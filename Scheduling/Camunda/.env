# Camunda 8 Self-Managed (lightweight): Orchestration Cluster on H2 + Connectors
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
CAMUNDA_VERSION=8.10.9
CAMUNDA_CONNECTORS_VERSION=8.10.5

# --- Host ports ---
# Operate / Tasklist / Admin (identity) / REST API
CAMUNDA_PORT=8152
# Zeebe gRPC
CAMUNDA_GRPC_PORT=26500
# Connectors (inbound webhooks)
CAMUNDA_CONNECTORS_PORT=8153

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
CAMUNDA_IP=172.20.15.60
CAMUNDA_CONNECTORS_IP=172.20.15.61

# --- Credentials & settings ---
# Web app login with the admin role (created on the first start)
CAMUNDA_ADMIN_USER=admin
CAMUNDA_ADMIN_PASSWORD=Password123
CAMUNDA_ADMIN_EMAIL=admin@example.com
# true: REST/gRPC APIs accept calls without credentials (local workers, tests); false: basic auth required
CAMUNDA_UNPROTECTED_API=true

# --- Tuning ---
CAMUNDA_JAVA_OPTS=-Xmx768m
