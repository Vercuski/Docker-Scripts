# Temporal (durable workflow engine: server + Web UI) - databases in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
TEMPORAL_VERSION=1.32.2
# Schema tool + temporal CLI (keep in step with TEMPORAL_VERSION)
TEMPORAL_ADMINTOOLS_VERSION=1.32.2
TEMPORAL_UI_VERSION=2.58.1
# Client image for the one-shot database setup (only psql is used)
TEMPORAL_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# gRPC frontend used by the .NET SDK (Temporalio NuGet package)
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8135

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
TEMPORAL_DB_INIT_IP=172.20.15.20
TEMPORAL_SCHEMA_IP=172.20.15.21
TEMPORAL_IP=172.20.15.22
TEMPORAL_NAMESPACE_INIT_IP=172.20.15.23
TEMPORAL_UI_IP=172.20.15.24

# --- Credentials & settings ---
# PostgreSQL stack superuser (used once to create the role and databases)
TEMPORAL_DB_ADMIN_USER=user@user.com
TEMPORAL_DB_ADMIN_PASSWORD=Password123
# Dedicated role; owns the temporal and temporal_visibility databases
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=Password123
# Namespace created on start, and its workflow history retention
TEMPORAL_NAMESPACE=default
TEMPORAL_NAMESPACE_RETENTION=72h
