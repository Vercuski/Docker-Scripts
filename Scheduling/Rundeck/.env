# Rundeck (runbook automation / job scheduler with a web UI) - database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
RUNDECK_VERSION=6.3.0
# Client image for the one-shot database setup (only psql is used)
RUNDECK_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
RUNDECK_PORT=4440

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
RUNDECK_DB_INIT_IP=172.20.15.40
RUNDECK_IP=172.20.15.41

# --- Credentials & settings ---
# Web UI / API administrator (realm.properties is rewritten from these on every start)
RUNDECK_ADMIN_USER=admin
RUNDECK_ADMIN_PASSWORD=Password123
# Static API token for the administrator (send as header X-Rundeck-Auth-Token)
RUNDECK_API_TOKEN=local-dev-rundeck-api-token
# PostgreSQL stack superuser (used once to create the role and database)
RUNDECK_DB_ADMIN_USER=user@user.com
RUNDECK_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
RUNDECK_DB_NAME=rundeck
RUNDECK_DB_USER=rundeck
RUNDECK_DB_PASSWORD=Password123
