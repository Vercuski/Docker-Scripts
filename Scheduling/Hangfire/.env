# Hangfire host (your published app on the ASP.NET runtime image)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Stack settings ---
# Must match the target framework of the published app
DOTNET_VERSION=10.0

# --- Host ports ---
HANGFIRE_PORT=5010

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
HANGFIRE_IP=192.168.16.210

# --- Credentials & settings ---
HANGFIRE_ENVIRONMENT=Production
HANGFIRE_CONNECTION_STRING='Server=mssqldb;Database=hangfire;User Id=sa;Password=Password123;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True;'
