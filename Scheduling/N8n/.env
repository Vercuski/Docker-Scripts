# n8n (visual workflow automation: cron/webhook triggers, 400+ integrations, code nodes) - database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
N8N_VERSION=2.47.7
# Client image for the one-shot database setup (only psql is used)
N8N_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
N8N_PORT=5678

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
N8N_DB_INIT_IP=172.20.15.50
N8N_IP=172.20.15.51
N8N_INIT_IP=172.20.15.52
N8N_RUNNERS_IP=172.20.15.53

# --- Credentials & settings ---
# Owner account, created by n8n-init on the first start (password: 8+ chars with a number and an uppercase letter)
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD=Password123
# Encrypts stored credentials. Changing it makes existing credentials unreadable.
N8N_ENCRYPTION_KEY=b5c540acaf789ac01df141beee755773817ddeaa46179802
# Shared secret between n8n and the n8n-runners container
N8N_RUNNERS_AUTH_TOKEN=e1e56e082b2a161e08327bb0a99d467a
# PostgreSQL stack superuser (used once to create the role and database)
N8N_DB_ADMIN_USER=user@user.com
N8N_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=Password123
# Time zone used by Schedule Trigger nodes
N8N_TIMEZONE=UTC
# Send anonymous usage data to n8n
N8N_DIAGNOSTICS_ENABLED=false
