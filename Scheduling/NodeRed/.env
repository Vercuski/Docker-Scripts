# Node-RED (flow-based automation)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
NODERED_VERSION=5.0.10

# --- Host ports ---
NODERED_PORT=1880

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
NODERED_IP=172.20.15.70

# --- Credentials & settings ---
# Editor / admin API login (hashed by settings.js at start)
NODERED_ADMIN_USER=admin
NODERED_ADMIN_PASSWORD=Password123
# Encrypts credentials stored with your flows - keep it once flows with credentials exist
NODERED_CREDENTIAL_SECRET=local-dev-node-red-credential-secret
NODERED_TZ=America/New_York
NODERED_LOG_LEVEL=info
