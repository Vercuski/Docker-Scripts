# Langfuse v4 (LLM tracing, prompts, evals) - PostgreSQL, Redis (DB 5) and RustFS stacks + own ClickHouse
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Web and worker use the same tag
LANGFUSE_VERSION=4.81.0
# ClickHouse version Langfuse tests against (>= 25.12 required)
LANGFUSE_CLICKHOUSE_VERSION=26.3.62.3
# Client image for the one-shot database setup (only psql is used)
LANGFUSE_DB_INIT_IMAGE=postgres:18
LANGFUSE_AWSCLI_VERSION=2.40.4

# --- Host ports ---
LANGFUSE_PORT=3014

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
LANGFUSE_DB_INIT_IP=172.20.27.40
LANGFUSE_S3_INIT_IP=172.20.27.41
LANGFUSE_CLICKHOUSE_IP=172.20.27.42
LANGFUSE_WEB_IP=172.20.27.43
LANGFUSE_WORKER_IP=172.20.27.44

# --- Credentials & settings ---
# Created on the first start (LANGFUSE_INIT_*); later changes in the UI
LANGFUSE_ADMIN_EMAIL=admin@example.com
LANGFUSE_ADMIN_NAME=Admin
LANGFUSE_ADMIN_PASSWORD=Password123
LANGFUSE_INIT_ORG_ID=docker-scripts
LANGFUSE_INIT_ORG_NAME=Docker-Scripts
LANGFUSE_INIT_PROJECT_ID=local-dev
LANGFUSE_INIT_PROJECT_NAME=Local dev
# Project API keys for SDKs / LiteLLM (must start with pk-lf- / sk-lf-)
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-dev
# true: only the admin (and invited users) can sign in
LANGFUSE_DISABLE_SIGNUP=true
LANGFUSE_NEXTAUTH_SECRET=local-dev-langfuse-nextauth-secret
LANGFUSE_SALT=local-dev-langfuse-salt
# 64 hex characters; encrypts LLM API keys stored in Langfuse - keep it once data exists
LANGFUSE_ENCRYPTION_KEY=37a45fe619cdacb6d58ce4da5f4bfd8946c526d62a5fb18f5dd1b3bf233f2919
# Own ClickHouse (only applied when its data folder is empty)
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=Password123
# Redis stack password (REDIS_PASSWORD in Databases/Redis/.env)
LANGFUSE_REDIS_PASSWORD=Password123
# RustFS stack root credentials (RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY) and the bucket to use
LANGFUSE_S3_ACCESS_KEY=admin
LANGFUSE_S3_SECRET_KEY=Password123
LANGFUSE_S3_BUCKET=langfuse
# RustFS as your browser reaches it (presigned media uploads)
LANGFUSE_S3_PUBLIC_ENDPOINT=http://localhost:9008
# PostgreSQL stack superuser (used once to create the role and database)
LANGFUSE_DB_ADMIN_USER=user@user.com
LANGFUSE_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=Password123
