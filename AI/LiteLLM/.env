# LiteLLM proxy (OpenAI-compatible LLM gateway) - database in the PostgreSQL stack, models in config.yaml
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
# litellm-database variant (includes the Prisma client for PostgreSQL); "-stable" tags are the release line
LITELLM_VERSION=v1.83.14-stable
# Client image for the one-shot database setup (only psql is used)
LITELLM_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
LITELLM_PORT=4000

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
LITELLM_DB_INIT_IP=172.20.27.30
LITELLM_IP=172.20.27.31

# --- Credentials & settings ---
# Admin API key (Authorization: Bearer ...); create per-app virtual keys with it
LITELLM_MASTER_KEY=sk-local-dev-litellm-master-key
# Encrypts provider credentials stored in the database: keep it once models are stored there
LITELLM_SALT_KEY=sk-local-dev-litellm-salt-key
# Admin UI login (http://localhost:4000/ui)
LITELLM_UI_USER=admin
LITELLM_UI_PASSWORD=Password123
# Langfuse project keys (match LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY in the Langfuse stack)
LITELLM_LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LITELLM_LANGFUSE_SECRET_KEY=sk-lf-local-dev
# Cloud provider keys for models you uncomment in config.yaml
LITELLM_OPENAI_API_KEY=
LITELLM_AZURE_API_BASE=
LITELLM_AZURE_API_KEY=
LITELLM_LOG_LEVEL=INFO
# PostgreSQL stack superuser (used once to create the role and database)
LITELLM_DB_ADMIN_USER=user@user.com
LITELLM_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=Password123
