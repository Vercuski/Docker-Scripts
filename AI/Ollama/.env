# Ollama (local LLM runtime) + one-shot model pull
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
OLLAMA_VERSION=0.40.16

# --- Host ports ---
OLLAMA_PORT=11434

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
OLLAMA_IP=172.20.27.10
OLLAMA_INIT_IP=172.20.27.11

# --- Credentials & settings ---
# Models pulled by ollama-init (comma separated, names from https://ollama.com/library).
# llama3.2:3b (~2 GB) is usable on CPU; nomic-embed-text is an embedding model for RAG
OLLAMA_MODELS=llama3.2:3b,nomic-embed-text

# --- Tuning ---
# How long a model stays loaded in memory after the last request
OLLAMA_KEEP_ALIVE=30m
# Default context window (tokens)
OLLAMA_CONTEXT_LENGTH=8192
# Requests served in parallel per loaded model
OLLAMA_NUM_PARALLEL=2
