# Open WebUI (chat UI for the Ollama stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
OPENWEBUI_VERSION=v0.13.3

# --- Host ports ---
OPENWEBUI_PORT=3013

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
OPENWEBUI_IP=172.20.27.20

# --- Credentials & settings ---
# Administrator created on the first start (later changes: UI > Settings > Account)
OPENWEBUI_ADMIN_EMAIL=admin@example.com
OPENWEBUI_ADMIN_PASSWORD=Password123
OPENWEBUI_ADMIN_NAME=Admin
# Signs login sessions (keep it once users exist)
OPENWEBUI_SECRET_KEY=local-dev-open-webui-secret-key
# Ollama embedding model for document uploads / RAG (pull it in the Ollama stack)
OPENWEBUI_EMBEDDING_MODEL=nomic-embed-text
