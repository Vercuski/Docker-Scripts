# Redash (SQL-first query editor, visualizations, dashboards, scheduled queries and alerts)
# Uses the PostgreSQL stack (Redash's own database) and the Redis stack (job queues).
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
REDASH_VERSION=26.9.0
# Client image for the one-shot database setup (only psql is used)
REDASH_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# Web UI + API (5000 is the Docker registry)
REDASH_PORT=8143

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
REDASH_DB_INIT_IP=172.20.20.40
REDASH_INIT_IP=172.20.20.41
REDASH_SERVER_IP=172.20.20.42
REDASH_SCHEDULER_IP=172.20.20.43
REDASH_WORKER_IP=172.20.20.44

# --- Credentials & settings ---
# Administrator created by redash-init on the first start
REDASH_ADMIN_EMAIL=admin@example.com
REDASH_ADMIN_PASSWORD=Password123
# Signs session cookies
REDASH_COOKIE_SECRET=2234bf83820b37bb6efdfb53d2a38d18ecb394fd3a60f8cd724f24b73d1deb00
# Encrypts stored data source credentials. Keep it once set.
REDASH_SECRET_KEY=c3557293fb908d5356373732ec6007bfacbdfdbddaee9ba2783b218e7ad5c111
# PostgreSQL stack superuser (used once to create the role and database)
REDASH_DB_ADMIN_USER=user@user.com
REDASH_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
REDASH_DB_NAME=redash
REDASH_DB_USER=redash
REDASH_DB_PASSWORD=Password123
# Redis stack password (Databases/Redis REDIS_PASSWORD) and database number
REDASH_REDIS_PASSWORD=Password123
REDASH_REDIS_DB=3

# --- Tuning ---
REDASH_WEB_WORKERS=2
REDASH_QUERY_WORKERS=2
