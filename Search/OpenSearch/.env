# OpenSearch (2 nodes) + Dashboards
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Stack settings ---
# Min 8 chars with upper, lower, digit and special character, and must score "strong" - Password123 is rejected
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Dev!OpenSearch#2026
OPENSEARCH_PORT=9201
OPENSEARCH_PA_PORT=9601
OPENSEARCH_DASHBOARDS_PORT=5602

# --- Image versions ---
OPENSEARCH_VERSION=latest
OPENSEARCH_DASHBOARDS_VERSION=latest

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
OPENSEARCH_NODE1_IP=192.168.16.156
OPENSEARCH_NODE2_IP=192.168.16.157
OPENSEARCH_DASHBOARDS_IP=192.168.16.158

# --- Credentials & settings ---
OPENSEARCH_CLUSTER_NAME=opensearch-cluster

# --- Tuning ---
# JVM heap per node (min = max)
OPENSEARCH_HEAP=512m
# Open-file ulimit (soft and hard)
OPENSEARCH_NOFILE_LIMIT=65536
