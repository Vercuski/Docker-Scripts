# OpenSearch (2 nodes) + Dashboards
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Pinned: a floating tag would upgrade the data folders on the next pull (OpenSearch can't downgrade)
OPENSEARCH_VERSION=3.9.0
OPENSEARCH_DASHBOARDS_VERSION=3.9.0

# --- Host ports ---
# REST API (9200 is Elasticsearch)
OPENSEARCH_PORT=9201
# Performance Analyzer
OPENSEARCH_PA_PORT=9601
OPENSEARCH_DASHBOARDS_PORT=5602

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
OPENSEARCH_NODE1_IP=172.20.16.20
OPENSEARCH_NODE2_IP=172.20.16.21
OPENSEARCH_DASHBOARDS_IP=172.20.16.22

# --- Credentials & settings ---
# Min 8 chars with upper, lower, digit and special character, and must score "strong" - Password123 is rejected
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Dev!OpenSearch#2026
OPENSEARCH_CLUSTER_NAME=opensearch-cluster

# --- Tuning ---
# JVM heap per node (min = max)
OPENSEARCH_HEAP=512m
# Open-file ulimit (soft and hard)
OPENSEARCH_NOFILE_LIMIT=65536
