# Typesense (typo-tolerant search engine with in-memory indexes, vector search and strict schemas)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
TYPESENSE_VERSION=30.2

# --- Host ports ---
# 8108 (the Typesense default) is used by Couchbase
TYPESENSE_PORT=8137

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
TYPESENSE_IP=172.20.16.40

# --- Credentials & settings ---
# Bootstrap admin API key (header X-TYPESENSE-API-KEY); create scoped keys for apps with POST /keys
TYPESENSE_API_KEY=uE0aCzMxoCDCfy84mWiS9T1dfjzas39h
