# Meilisearch (typo-tolerant instant search with hybrid/vector search and a built-in mini dashboard)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
MEILI_VERSION=v1.57.0

# --- Host ports ---
MEILI_PORT=7700

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
MEILI_IP=172.20.16.30

# --- Credentials & settings ---
# Master key (at least 16 bytes). Use it only to create API keys; apps should use the generated search/admin keys.
MEILI_MASTER_KEY=bnGWQ1ndZ5DaHAwfUGpyN1Vp536BaGo2
# development = mini dashboard at the root URL; production = dashboard off and a master key is mandatory
MEILI_ENV=development
# Send anonymous usage data to Meilisearch
MEILI_NO_ANALYTICS=true
