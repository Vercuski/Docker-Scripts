# Selenium Grid 4 (hub + Chrome, Firefox and Edge nodes)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
# One tag for hub and nodes (grid version + build date); each node tag ships the newest stable browser of that build
SELENIUM_VERSION=4.52.0-20261101

# --- Host ports ---
# Grid UI + WebDriver endpoint (4444 is Ory Hydra)
SELENIUM_HUB_PORT=4447
# noVNC (watch the browsers)
SELENIUM_CHROME_VNC_PORT=7900
SELENIUM_FIREFOX_VNC_PORT=7901
SELENIUM_EDGE_VNC_PORT=7902

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
SELENIUM_HUB_IP=172.20.23.60
SELENIUM_CHROME_IP=172.20.23.61
SELENIUM_FIREFOX_IP=172.20.23.62
SELENIUM_EDGE_IP=172.20.23.63

# --- Credentials & settings ---
SELENIUM_VNC_PASSWORD=Password123
SELENIUM_SCREEN_WIDTH=1920
SELENIUM_SCREEN_HEIGHT=1080

# --- Tuning ---
# Parallel browser sessions per node
SELENIUM_MAX_SESSIONS=2
