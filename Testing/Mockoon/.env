# Mockoon CLI (mock API from a Mockoon data file in ./data)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
MOCKOON_VERSION=9.10.0

# --- Host ports ---
MOCKOON_PORT=3009

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
MOCKOON_IP=172.20.23.30

# --- Credentials & settings ---
# Data file in ./data to serve
MOCKOON_DATA_FILE=sample-api.json
# Bearer token for the admin API (/mockoon-admin)
MOCKOON_ADMIN_TOKEN=local-dev-mockoon-admin-token
