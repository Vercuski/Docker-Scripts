# WireMock (HTTP API mocking) - stubs in ./mappings, response bodies in ./__files
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
WIREMOCK_VERSION=3.13.2

# --- Host ports ---
# Mocks + admin API (/__admin)
WIREMOCK_PORT=8147

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
WIREMOCK_IP=172.20.23.10

# --- Tuning ---
# Requests kept for verification (/__admin/requests); 0 disables the journal
WIREMOCK_JOURNAL_ENTRIES=1000
