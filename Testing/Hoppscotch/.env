# Hoppscotch Community Edition (all-in-one) - database in the PostgreSQL stack, sign-in emails to Mailpit
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
HOPPSCOTCH_VERSION=2026.10.1
# Client image for the one-shot database setup (only psql is used)
HOPPSCOTCH_DB_INIT_IMAGE=postgres:18
HOPPSCOTCH_CURL_IMAGE=curlimages/curl:8.23.0

# --- Host ports ---
# App (/), admin dashboard (/admin) and backend (/backend) on one port
HOPPSCOTCH_PORT=3010

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
HOPPSCOTCH_DB_INIT_IP=172.20.23.80
HOPPSCOTCH_MIGRATE_IP=172.20.23.81
HOPPSCOTCH_IP=172.20.23.82
HOPPSCOTCH_INIT_IP=172.20.23.83

# --- Credentials & settings ---
# Encrypts secrets stored in the database: exactly 32 characters; never change it once the database has data
HOPPSCOTCH_DATA_ENCRYPTION_KEY=Dk7qL2xV9mR4tW8zB3nF6hJ1sP5cY0aE
# Sender of the magic-link emails (set at onboarding; change later in the admin dashboard)
HOPPSCOTCH_MAIL_FROM=hoppscotch@example.com
# PostgreSQL stack superuser (used once to create the role and database)
HOPPSCOTCH_DB_ADMIN_USER=user@user.com
HOPPSCOTCH_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
HOPPSCOTCH_DB_NAME=hoppscotch
HOPPSCOTCH_DB_USER=hoppscotch
HOPPSCOTCH_DB_PASSWORD=Password123
