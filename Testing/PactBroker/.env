# Pact Broker (contract testing) - database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
PACT_BROKER_VERSION=3.0.0-pactbroker2.121.2
# Client image for the one-shot database setup (only psql is used)
PACT_BROKER_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
PACT_BROKER_PORT=9292

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
PACT_BROKER_DB_INIT_IP=172.20.23.70
PACT_BROKER_IP=172.20.23.71

# --- Credentials & settings ---
# Read/write account (publish pacts and verification results)
PACT_BROKER_USER=pact
PACT_BROKER_PASSWORD=Password123
# Read-only account (UI browsing, can-i-deploy)
PACT_BROKER_READ_ONLY_USER=pact-reader
PACT_BROKER_READ_ONLY_PASSWORD=Password123
# true: anyone can read without logging in
PACT_BROKER_ALLOW_PUBLIC_READ=false
PACT_BROKER_LOG_LEVEL=info
# PostgreSQL stack superuser (used once to create the role and database)
PACT_BROKER_DB_ADMIN_USER=user@user.com
PACT_BROKER_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
PACT_BROKER_DB_NAME=pact_broker
PACT_BROKER_DB_USER=pact_broker
PACT_BROKER_DB_PASSWORD=Password123
