# Microcks all-in-one (in-memory) + one-shot import of ./artifacts
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
MICROCKS_VERSION=1.16.0
MICROCKS_CURL_IMAGE=curlimages/curl:8.23.0

# --- Host ports ---
# UI + REST API + REST/SOAP/GraphQL mocks
MICROCKS_PORT=8148
# gRPC mocks (9090 is Prometheus)
MICROCKS_GRPC_PORT=9005

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
MICROCKS_IP=172.20.23.20
MICROCKS_INIT_IP=172.20.23.21

# --- Tuning ---
MICROCKS_JAVA_OPTIONS=-Xmx512m
