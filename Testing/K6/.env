# Grafana k6 (one-shot load test runner; scripts in ./scripts, HTML reports in the results volume)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
K6_VERSION=2.4.0

# --- Host ports ---
# Web dashboard while a test runs
K6_DASHBOARD_PORT=5665

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
K6_IP=172.20.23.40

# --- Credentials & settings ---
# Script in ./scripts run by "docker compose up"
K6_SCRIPT=smoke.js
# URL passed to scripts as __ENV.TARGET_URL (empty: smoke.js calls the WireMock sample stub)
K6_TARGET_URL=
# Extra output besides the dashboard, e.g. opentelemetry (needs Observability/OpenTelemetry), json=/results/out.json
K6_EXTRA_OUTPUT=
