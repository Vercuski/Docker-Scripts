# Toxiproxy (fault-injection TCP proxy) - proxies defined in config/toxiproxy.json
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
TOXIPROXY_VERSION=2.13.0

# --- Host ports ---
TOXIPROXY_API_PORT=8474
# Proxy listeners (container-side ports are fixed in config/toxiproxy.json)
TOXIPROXY_POSTGRES_PORT=15432
TOXIPROXY_MSSQL_PORT=11433
TOXIPROXY_REDIS_PORT=16379
TOXIPROXY_RABBITMQ_PORT=15673
TOXIPROXY_WIREMOCK_PORT=18147

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
TOXIPROXY_IP=172.20.23.50
