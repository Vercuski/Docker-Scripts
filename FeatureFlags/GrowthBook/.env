# GrowthBook open source (feature flags + experiments) with its own MongoDB 8.0
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
GROWTHBOOK_VERSION=5.2.1
# Major version - a data folder created by 8.0 can't be opened by an older major
GROWTHBOOK_MONGO_VERSION=8.0
GROWTHBOOK_CURL_IMAGE=curlimages/curl:8.23.0

# --- Host ports ---
GROWTHBOOK_UI_PORT=3011
GROWTHBOOK_API_PORT=3012

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
GROWTHBOOK_MONGO_IP=172.20.24.30
GROWTHBOOK_IP=172.20.24.31
GROWTHBOOK_INIT_IP=172.20.24.32

# --- Credentials & settings ---
# Super admin + organisation created by growthbook-init on an empty database (later changes: UI)
GROWTHBOOK_ADMIN_EMAIL=admin@example.com
GROWTHBOOK_ADMIN_NAME=Admin
GROWTHBOOK_ADMIN_PASSWORD=Password123
GROWTHBOOK_ORGANIZATION=Docker-Scripts
GROWTHBOOK_JWT_SECRET=local-dev-growthbook-jwt-secret
# Encrypts stored data source credentials: keep it once data exists
GROWTHBOOK_ENCRYPTION_KEY=local-dev-growthbook-encryption-key
# MongoDB root account - only applied when the data folder is empty
GROWTHBOOK_MONGO_USER=root
GROWTHBOOK_MONGO_PASSWORD=Password123
