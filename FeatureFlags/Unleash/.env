# Unleash open source (feature flags) - database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
UNLEASH_VERSION=8.3.1
# Client image for the one-shot database setup (only psql is used)
UNLEASH_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
UNLEASH_PORT=4242

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
UNLEASH_DB_INIT_IP=172.20.24.10
UNLEASH_IP=172.20.24.11

# --- Credentials & settings ---
# Administrator created with the database (later changes: UI > Profile)
UNLEASH_ADMIN_USER=admin
UNLEASH_ADMIN_PASSWORD=Password123
# API tokens created on first start: <project>:<environment>.<secret>
UNLEASH_CLIENT_TOKEN=default:development.local-dev-unleash-client-token
UNLEASH_FRONTEND_TOKEN=default:development.local-dev-unleash-frontend-token
UNLEASH_ADMIN_TOKEN=*:*.local-dev-unleash-admin-token
# PostgreSQL stack superuser (used once to create the role and database)
UNLEASH_DB_ADMIN_USER=user@user.com
UNLEASH_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
UNLEASH_DB_NAME=unleash
UNLEASH_DB_USER=unleash
UNLEASH_DB_PASSWORD=Password123
