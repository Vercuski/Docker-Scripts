# flagd (OpenFeature flag daemon) - flags as code in ./flags
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
FLAGD_VERSION=v0.18.2

# --- Host ports ---
# Evaluation API (gRPC + Connect)
FLAGD_PORT=8013
# Health + Prometheus metrics
FLAGD_MANAGEMENT_PORT=8014
# OFREP (HTTP)
FLAGD_OFREP_PORT=8016

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
FLAGD_IP=172.20.24.40

# --- Credentials & settings ---
# Flag definition file in ./flags
FLAGD_FLAGS_FILE=flags.json
