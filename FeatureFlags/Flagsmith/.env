# Flagsmith open source (feature flags + remote config) - database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
FLAGSMITH_VERSION=2.291.0
# Client image for the one-shot database setup (only psql is used)
FLAGSMITH_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# UI + API (8000 is Kroki)
FLAGSMITH_PORT=8149

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
FLAGSMITH_DB_INIT_IP=172.20.24.20
FLAGSMITH_IP=172.20.24.21
FLAGSMITH_INIT_IP=172.20.24.22

# --- Credentials & settings ---
# Administrator (created with the database; flagsmith-init resets the password on every start)
FLAGSMITH_ADMIN_EMAIL=admin@example.com
FLAGSMITH_ADMIN_PASSWORD=Password123
# Organisation and project created with the database (the project gets Development and Production environments)
FLAGSMITH_ORGANISATION=Docker-Scripts
FLAGSMITH_PROJECT=Default
# true: only invited users can sign up
FLAGSMITH_PREVENT_SIGNUP=true
FLAGSMITH_SECRET_KEY=local-dev-flagsmith-django-secret-key-change-me
# PostgreSQL stack superuser (used once to create the role and database)
FLAGSMITH_DB_ADMIN_USER=user@user.com
FLAGSMITH_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
FLAGSMITH_DB_NAME=flagsmith
FLAGSMITH_DB_USER=flagsmith
FLAGSMITH_DB_PASSWORD=Password123
