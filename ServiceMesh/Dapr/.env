# Dapr control plane (placement, scheduler, dashboard) + one sidecar for an app running on your machine
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Runtime version for placement, scheduler and daprd (keep them equal)
DAPR_VERSION=1.19.1
DAPR_DASHBOARD_VERSION=0.15.0

# --- Host ports ---
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_PLACEMENT_PORT=50005
DAPR_SCHEDULER_PORT=50006
DAPR_DASHBOARD_PORT=8151

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
DAPR_PLACEMENT_IP=172.20.26.10
DAPR_SCHEDULER_IP=172.20.26.11
DAPR_DASHBOARD_IP=172.20.26.12
DAPR_SIDECAR_IP=172.20.26.20

# --- Credentials & settings ---
# The app this sidecar serves: Dapr app id and the port your app listens on (on your machine)
DAPR_APP_ID=my-app
DAPR_APP_PORT=5000
# http or grpc
DAPR_APP_PROTOCOL=http
# Redis stack password (REDIS_PASSWORD in Databases/Redis/.env), used by the state store and pub/sub
DAPR_REDIS_PASSWORD=Password123
DAPR_LOG_LEVEL=info
