# Mailpit (SMTP catcher with web UI)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
MAILPIT_VERSION=latest

# --- Host ports ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
MAILPIT_IP=192.168.16.140

# --- Credentials & settings ---
MAILPIT_SMTP_AUTH_ACCEPT_ANY=true
MAILPIT_SMTP_AUTH_ALLOW_INSECURE=true
MAILPIT_TZ=America/New_York

# --- Tuning ---
# Oldest messages are pruned beyond this count (0 = unlimited)
MAILPIT_MAX_MESSAGES=5000
