# smtp4dev (.NET fake SMTP server with web UI, IMAP and POP3) - an alternative to Mailpit
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
SMTP4DEV_VERSION=3.16.1

# --- Host ports ---
SMTP4DEV_UI_PORT=8115
# SMTP (1025 is used by Mailpit)
SMTP4DEV_SMTP_PORT=2525
SMTP4DEV_IMAP_PORT=1143
SMTP4DEV_POP3_PORT=1110

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
SMTP4DEV_IP=172.20.8.20

# --- Tuning ---
# Messages kept before the oldest are deleted
SMTP4DEV_MAX_MESSAGES=1000
