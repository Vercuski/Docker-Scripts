# SonarQube
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
SONARQUBE_VERSION=community

# --- Host ports ---
SONARQUBE_PORT=9000

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
SONARQUBE_IP=192.168.16.170

# --- Credentials & settings ---
# PostgreSQL alternative: jdbc:postgresql://postgresql:5432/sonar
SONAR_JDBC_URL=jdbc:sqlserver://mssqldb;databaseName=sonar;encrypt=true;trustServerCertificate=true;
SONAR_JDBC_USERNAME=sonarqube
SONAR_JDBC_PASSWORD=Password123
