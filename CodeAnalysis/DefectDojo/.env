# DefectDojo (vulnerability management: collects findings from Trivy, SonarQube, ZAP, Dependency-Track, ...)
# Uses the PostgreSQL stack; brings its own Valkey for the Celery task queue.
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# defectdojo-django and defectdojo-nginx are released together with the same version
DEFECTDOJO_VERSION=3.5.103
DEFECTDOJO_VALKEY_VERSION=9.1-alpine
# Only used by the one-shot database setup container (psql client)
DEFECTDOJO_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
DEFECTDOJO_PORT=8102

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
DEFECTDOJO_DB_INIT_IP=172.20.4.40
DEFECTDOJO_INITIALIZER_IP=172.20.4.41
DEFECTDOJO_UWSGI_IP=172.20.4.42
DEFECTDOJO_CELERYBEAT_IP=172.20.4.43
DEFECTDOJO_CELERYWORKER_IP=172.20.4.44
DEFECTDOJO_NGINX_IP=172.20.4.45
DEFECTDOJO_VALKEY_IP=172.20.4.46

# --- Credentials & settings ---
# Login for the PostgreSQL stack; the "defectdojo" database is created on first start
DEFECTDOJO_DB_NAME=defectdojo
DEFECTDOJO_DB_USER=user@user.com
DEFECTDOJO_DB_PASSWORD=Password123
# Same login as a URL: @ in the user name is written as %40
DEFECTDOJO_DATABASE_URL=postgresql://user%40user.com:Password123@postgresql:5432/defectdojo
# First admin - only created when the database is empty
DEFECTDOJO_ADMIN_USER=admin
DEFECTDOJO_ADMIN_PASSWORD=Password123
DEFECTDOJO_ADMIN_MAIL=admin@example.com
# Local-dev secrets. The AES key encrypts stored tool credentials: keep it once you have data.
DEFECTDOJO_SECRET_KEY=LocalDevOnly-defectdojo-secret-key-0123456789
DEFECTDOJO_CREDENTIAL_AES_256_KEY=LocalDevOnlyDefectDojoAesKey32Ch
