# OWASP Dependency-Track v5 (API server + frontend, uses the PostgreSQL stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# API server and frontend are released together with the same version
DTRACK_VERSION=5.2.1
# Only used by the one-shot database setup container (psql client)
DTRACK_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# REST API (the frontend calls it from your browser, so it must be reachable from the host)
DTRACK_API_PORT=8098
# Web UI
DTRACK_UI_PORT=8099

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
DTRACK_DB_INIT_IP=172.20.4.20
DTRACK_APISERVER_IP=172.20.4.21
DTRACK_FRONTEND_IP=172.20.4.22

# --- Credentials & settings ---
# Login for the PostgreSQL stack; the "dtrack" database is created on first start
DTRACK_DB_NAME=dtrack
DTRACK_DB_USER=user@user.com
DTRACK_DB_PASSWORD=Password123

# --- Tuning ---
# The API server needs at least ~2 GB (vulnerability database mirroring and analysis)
DTRACK_APISERVER_MEM_LIMIT=2g
