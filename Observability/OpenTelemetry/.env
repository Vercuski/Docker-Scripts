# OpenTelemetry Collector + Grafana Tempo + Grafana Loki
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Collector config keys change between releases - test before bumping
OTEL_COLLECTOR_VERSION=0.161.0
# tempo.yaml is written for Tempo 3.x (no ingester/compactor blocks)
TEMPO_VERSION=3.0.3
LOKI_VERSION=3.7.8

# --- Host ports ---
# OTLP endpoints your apps export to
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8889
OTEL_HEALTH_PORT=13133
TEMPO_PORT=3200
LOKI_PORT=3100

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
OTEL_COLLECTOR_IP=172.20.11.20
TEMPO_IP=172.20.11.21
LOKI_IP=172.20.11.22
