# Jaeger v2 (distributed tracing UI + OTLP receiver, built on the OpenTelemetry Collector)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
JAEGER_VERSION=2.23.0

# --- Host ports ---
JAEGER_UI_PORT=16686
# OTLP receivers (4317/4318 are used by the OpenTelemetry collector stack)
JAEGER_OTLP_GRPC_PORT=14317
JAEGER_OTLP_HTTP_PORT=14318

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
JAEGER_IP=172.20.11.40

# --- Tuning ---
# How long traces are kept in the Badger store
JAEGER_RETENTION=168h
