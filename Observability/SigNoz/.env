# SigNoz (OpenTelemetry-native APM: traces, metrics, logs, dashboards and alerts in one UI, stored in ClickHouse)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
SIGNOZ_VERSION=v0.150.0
SIGNOZ_COLLECTOR_VERSION=v0.144.15
# ClickHouse server and keeper must share a version
SIGNOZ_CLICKHOUSE_VERSION=25.12.5
# Client image for the one-shot database setup (only psql is used)
SIGNOZ_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
SIGNOZ_UI_PORT=8122
# OTLP receivers (4317/4318 OpenTelemetry stack, 14317/14318 Jaeger, 24317/24318 otel-lgtm)
SIGNOZ_OTLP_GRPC_PORT=34317
SIGNOZ_OTLP_HTTP_PORT=34318

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
SIGNOZ_DB_INIT_IP=172.20.11.90
SIGNOZ_KEEPER_IP=172.20.11.91
SIGNOZ_CLICKHOUSE_SCRIPTS_IP=172.20.11.92
SIGNOZ_CLICKHOUSE_IP=172.20.11.93
SIGNOZ_MIGRATOR_IP=172.20.11.94
SIGNOZ_IP=172.20.11.95
SIGNOZ_COLLECTOR_IP=172.20.11.96

# --- Credentials & settings ---
# The first visit to the UI creates the admin account.
# PostgreSQL stack superuser (used once to create the metadata role and database)
SIGNOZ_DB_ADMIN_USER=user@user.com
SIGNOZ_DB_ADMIN_PASSWORD=Password123
# Dedicated metadata database and role (users, dashboards, alerts)
SIGNOZ_DB_NAME=signoz
SIGNOZ_DB_USER=signoz
SIGNOZ_DB_PASSWORD=Password123
