# grafana/otel-lgtm (OpenTelemetry Collector + Prometheus + Tempo + Loki + Pyroscope + Grafana in ONE container)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
OTEL_LGTM_VERSION=0.41.0

# --- Host ports ---
# Grafana (3000 is used by the Grafana stack)
OTEL_LGTM_GRAFANA_PORT=3006
# OTLP receivers (4317/4318 OpenTelemetry stack, 14317/14318 Jaeger)
OTEL_LGTM_OTLP_GRPC_PORT=24317
OTEL_LGTM_OTLP_HTTP_PORT=24318

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
OTEL_LGTM_IP=172.20.11.80
