# .NET Aspire Dashboard (standalone OTLP viewer)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
ASPIRE_DASHBOARD_VERSION=latest

# --- Host ports ---
ASPIRE_UI_PORT=18888
ASPIRE_OTLP_GRPC_PORT=18889
ASPIRE_OTLP_HTTP_PORT=18890

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
ASPIRE_DASHBOARD_IP=192.168.16.120

# --- Credentials & settings ---
# true = no login token and no OTLP API key (local dev only)
ASPIRE_ALLOW_ANONYMOUS=true
# Comma-separated origins allowed to send browser telemetry, or *
ASPIRE_OTLP_CORS_ORIGINS=*

# --- Tuning ---
ASPIRE_MAX_LOG_COUNT=10000
ASPIRE_MAX_TRACE_COUNT=10000
ASPIRE_MAX_METRICS_COUNT=50000
