# cAdvisor (per-container CPU / memory / network / disk metrics, scraped by the Prometheus stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
CADVISOR_VERSION=0.61.0

# --- Host ports ---
CADVISOR_PORT=8121

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
CADVISOR_IP=172.20.11.70

# --- Tuning ---
# How often container stats are collected
CADVISOR_HOUSEKEEPING_INTERVAL=15s
