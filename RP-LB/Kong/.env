# Kong Gateway OSS 3.9 (API gateway: routing, auth, rate limiting, transformations via plugins), DB-less mode
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
# 3.9 is the last open-source image; later versions ship only as kong/kong-gateway (Enterprise build, free mode)
KONG_VERSION=3.9.4

# --- Host ports ---
# Proxy (8000 is used by Kroki)
KONG_PROXY_PORT=8131
# Admin API (read-only in DB-less mode except POST /config; 8001 is kubectl proxy)
KONG_ADMIN_PORT=8132
# Kong Manager OSS (web UI, read-only in DB-less mode)
KONG_MANAGER_PORT=8133

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
KONG_IP=172.20.14.70

# --- Tuning ---
KONG_LOG_LEVEL=notice
