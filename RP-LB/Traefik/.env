# Traefik v3 (reverse proxy that configures itself from Docker labels; file provider for everything else)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
TRAEFIK_VERSION=v3.7.19

# --- Host ports ---
# HTTP entrypoint (80/443 are used by Nginx Proxy Manager)
TRAEFIK_HTTP_PORT=8126
# Dashboard + API
TRAEFIK_DASHBOARD_PORT=8127

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
TRAEFIK_IP=172.20.14.30

# --- Tuning ---
TRAEFIK_LOG_LEVEL=INFO
