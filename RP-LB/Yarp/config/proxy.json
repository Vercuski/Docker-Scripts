{
  "ReverseProxy": {
    "Routes": {
      "webservers": {
        "ClusterId": "webservers",
        "Match": {
          "Path": "/web/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/web"
          }
        ]
      }
    },
    "Clusters": {
      "webservers": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/"
          }
        },
        "Destinations": {
          "nginx": {
            "Address": "http://nginx:80/"
          },
          "apache": {
            "Address": "http://apache:80/"
          }
        }
      }
    }
  }
}
