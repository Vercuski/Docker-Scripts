# YARP (Microsoft's .NET reverse proxy library) hosted in a small ASP.NET Core app built from ./src
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
# .NET SDK / ASP.NET runtime tag used by src/Dockerfile
DOTNET_VERSION=10.0
# Yarp.ReverseProxy NuGet package version
YARP_PACKAGE_VERSION=2.3.0

# --- Host ports ---
YARP_PORT=8129

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
YARP_IP=172.20.14.50

# --- Credentials & settings ---
ASPNETCORE_ENVIRONMENT=Development
