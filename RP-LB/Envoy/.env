# Envoy proxy (L4/L7 proxy behind most service meshes) with a static envoy.yaml
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
ENVOY_VERSION=v1.39.6

# --- Host ports ---
ENVOY_PORT=8130
# Admin interface (stats, clusters, config_dump)
ENVOY_ADMIN_PORT=9902

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
ENVOY_IP=172.20.14.60
