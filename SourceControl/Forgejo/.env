# Forgejo (community fork of Gitea) + Forgejo Actions runner
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
FORGEJO_VERSION=17.0.1
FORGEJO_RUNNER_VERSION=13.2.1

# --- Host ports ---
# Web UI + git over HTTP (3001 is Gitea)
FORGEJO_HTTP_PORT=3007
# git over SSH (2222 is Gitea)
FORGEJO_SSH_PORT=2223

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
FORGEJO_IP=172.20.19.20
FORGEJO_INIT_IP=172.20.19.21
FORGEJO_RUNNER_IP=172.20.19.22

# --- Credentials & settings ---
# Administrator created by forgejo-init (password reset to this value on every start)
FORGEJO_ADMIN_USER=forgejo-admin
FORGEJO_ADMIN_PASSWORD=Password123
FORGEJO_ADMIN_EMAIL=admin@example.com
# host.docker.internal works from your browser and from Actions job containers (actions/checkout)
FORGEJO_ROOT_URL=http://host.docker.internal:3007/
FORGEJO_SSH_DOMAIN=localhost
FORGEJO_RUNNER_NAME=docker-runner
