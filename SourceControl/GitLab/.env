# GitLab Community Edition (git server, merge requests, issues, CI/CD, package and container registries) - all-in-one Omnibus image
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
GITLAB_VERSION=19.5.6-ce.0

# --- Host ports ---
# Web UI + git over HTTP. GitLab also listens on this number inside the container (external_url).
GITLAB_HTTP_PORT=8141
# git over SSH (2222 Gitea, 2223 Forgejo)
GITLAB_SSH_PORT=2224

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
GITLAB_IP=172.20.19.30

# --- Credentials & settings ---
# Password of the "root" user, applied only on the first start (empty data folders). GitLab rejects short or
# common passwords (including ones containing "gitlab"), and then silently creates no root user at all.
GITLAB_ROOT_PASSWORD=1NRCkjlt2xBp!7q

# --- Tuning ---
# Sidekiq background job threads (GitLab default 20)
GITLAB_SIDEKIQ_CONCURRENCY=10
# Shared memory for the bundled Prometheus/PostgreSQL
GITLAB_SHM_SIZE=256m
