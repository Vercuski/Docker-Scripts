# Gitea + Gitea Actions runner
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
GITEA_VERSION=latest
GITEA_RUNNER_VERSION=latest

# --- Host ports ---
# Host port for git over SSH; also shown in clone URLs
GITEA_SSH_PORT=2222
GITEA_HTTP_PORT=3001

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
GITEA_IP=192.168.16.225
GITEA_RUNNER_IP=192.168.16.226

# --- Credentials & settings ---
# Owner of the files in the data volume
GITEA_UID=1000
GITEA_GID=1000
# Public URL of the web UI - must be reachable from the browser AND from CI job containers
GITEA_ROOT_URL=http://host.docker.internal:3001/
GITEA_SSH_DOMAIN=localhost
# Shared secret used by the runner to register (generate your own: openssl rand -hex 24)
GITEA_RUNNER_REGISTRATION_TOKEN=8f3c1d6e2a9b4c7d5e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b
GITEA_RUNNER_NAME=docker-runner
