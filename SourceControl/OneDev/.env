# OneDev (git server with built-in CI/CD, issues, packages and code search) - embedded database
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
ONEDEV_VERSION=17.2.1

# --- Host ports ---
# Web UI + git over HTTP
ONEDEV_HTTP_PORT=6610
# git over SSH
ONEDEV_SSH_PORT=6611

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
ONEDEV_IP=172.20.19.40

# --- Credentials & settings ---
# Administrator and server URL, used only on the first start (empty data folder) to skip the setup page
ONEDEV_ADMIN_USER=admin
ONEDEV_ADMIN_PASSWORD=Password123
ONEDEV_ADMIN_EMAIL=admin@example.com
ONEDEV_SERVER_URL=http://localhost:6610
