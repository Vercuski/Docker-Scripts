# Dozzle (live log viewer for every container on this Docker host)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
DOZZLE_VERSION=v11.4.3

# --- Host ports ---
DOZZLE_PORT=8103

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
DOZZLE_IP=172.20.5.20

# --- Credentials & settings ---
# Show only containers whose name matches, e.g. name=keycloak (empty = all containers)
DOZZLE_FILTER=
# true = allow starting/stopping/restarting containers from the UI
DOZZLE_ENABLE_ACTIONS=true
# true = allow opening a shell in containers from the UI
DOZZLE_ENABLE_SHELL=false
