# Docker Registry + UI
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
REGISTRY_VERSION=3
REGISTRY_UI_VERSION=latest

# --- Host ports ---
REGISTRY_PORT=5000
REGISTRY_UI_PORT=5001

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
REGISTRY_IP=192.168.16.180
REGISTRY_UI_IP=192.168.16.181

# --- Credentials & settings ---
REGISTRY_DELETE_ENABLED=true
REGISTRY_UI_TITLE='Docker Registry UI'
REGISTRY_UI_DELETE_IMAGES=true

# --- Tuning ---
REGISTRY_UI_TAGLIST_PAGE_SIZE=100
REGISTRY_UI_CATALOG_LIMIT=1000
