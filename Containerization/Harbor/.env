# Harbor (registry with UI, projects/RBAC, Trivy scanning, replication, proxy cache; uses the PostgreSQL stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# All goharbor/* images are released together with the same tag
HARBOR_VERSION=v2.15.5
# Only used by the one-shot database setup container (psql client)
HARBOR_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# Web UI, API and registry (docker login/push/pull localhost:8104). Also used in Harbor's external URL.
HARBOR_PORT=8104

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
HARBOR_DB_INIT_IP=172.20.5.40
HARBOR_INIT_IP=172.20.5.41
HARBOR_REGISTRY_IP=172.20.5.42
HARBOR_REGISTRYCTL_IP=172.20.5.43
HARBOR_CORE_IP=172.20.5.44
HARBOR_PORTAL_IP=172.20.5.45
HARBOR_JOBSERVICE_IP=172.20.5.46
HARBOR_REDIS_IP=172.20.5.47
HARBOR_PROXY_IP=172.20.5.48
HARBOR_TRIVY_IP=172.20.5.49

# --- Credentials & settings ---
# Initial admin password (user "admin") - only applied when the database is empty
HARBOR_ADMIN_PASSWORD=Password123
# PostgreSQL stack superuser, used once to create Harbor's own role and database
HARBOR_DB_ADMIN_USER=user@user.com
HARBOR_DB_ADMIN_PASSWORD=Password123
# Role and database Harbor connects with (created on first start)
HARBOR_DB_NAME=harbor
HARBOR_DB_USER=harbor
HARBOR_DB_PASSWORD=Password123
# Local-dev secrets shared between Harbor's services. Exact lengths: core/jobservice 16, CSRF 32 characters.
HARBOR_CORE_SECRET=LocalDevCore0016
HARBOR_JOBSERVICE_SECRET=LocalDevJobs0016
HARBOR_CSRF_KEY=LocalDevOnlyHarborCsrfKey0000032
HARBOR_REGISTRY_PASSWORD=LocalDevOnly-harbor-registry-pass
