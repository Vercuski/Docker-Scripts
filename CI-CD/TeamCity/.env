# JetBrains TeamCity server + one build agent (.NET SDK, git, Docker CLI)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Server and agent must be the same version (the agent upgrades itself from the server otherwise)
TEAMCITY_VERSION=2026.2.2

# --- Host ports ---
# UI + REST API (8111 is draw.io)
TEAMCITY_PORT=8145

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
TEAMCITY_IP=172.20.22.20
TEAMCITY_AGENT_IP=172.20.22.21

# --- Credentials & settings ---
# Administrator: created in the browser on first visit (TeamCity can't preset it)
TEAMCITY_AGENT_NAME=docker-agent

# --- Tuning ---
TEAMCITY_SERVER_MEM_OPTS=-Xmx2g -XX:ReservedCodeCacheSize=640m
