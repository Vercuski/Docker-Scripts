# Jenkins LTS (built image with plugins + Docker CLI, configured by casc/jenkins.yaml)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Base image tag; changing it rebuilds jenkins-plugins (docker compose up -d --build)
JENKINS_VERSION=2.580.2-lts-jdk21
# docker image the Docker CLI binary is copied from
JENKINS_DOCKER_CLI_VERSION=29-cli

# --- Host ports ---
# UI + API (8080 is CockroachDB)
JENKINS_PORT=8144

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
JENKINS_IP=172.20.22.10

# --- Credentials & settings ---
# Administrator (Configuration as Code resets the password to this value on every start)
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=Password123

# --- Tuning ---
JENKINS_EXECUTORS=2
JENKINS_JAVA_OPTS=-Xmx1g
