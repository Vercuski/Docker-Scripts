# Woodpecker CI server + agent, signing in through the Gitea stack (OAuth2 app created by woodpecker-init)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Server uses the -alpine variant of this tag (it needs a shell to read the OAuth2 credentials)
WOODPECKER_VERSION=v3.20.1
WOODPECKER_CURL_IMAGE=curlimages/curl:8.23.0

# --- Host ports ---
# UI + API (also the OAuth2 redirect: http://localhost:<port>/authorize)
WOODPECKER_PORT=8146

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
WOODPECKER_INIT_IP=172.20.22.30
WOODPECKER_SERVER_IP=172.20.22.31
WOODPECKER_AGENT_IP=172.20.22.32

# --- Credentials & settings ---
# YOUR Gitea administrator (the account created in the Gitea installer); used once to create the OAuth2 app
WOODPECKER_GITEA_ADMIN_USER=gitea_admin
WOODPECKER_GITEA_ADMIN_PASSWORD=Password123
# Gitea as your browser reaches it (Gitea stack host port)
WOODPECKER_GITEA_PUBLIC_URL=http://localhost:3001
# Gitea users that are Woodpecker admins (comma separated)
WOODPECKER_ADMIN=gitea_admin
# true: any Gitea user can log in; false: only existing Woodpecker users
WOODPECKER_OPEN=true
WOODPECKER_AGENT_SECRET=local-dev-woodpecker-agent-secret
WOODPECKER_GRPC_SECRET=local-dev-woodpecker-grpc-secret
WOODPECKER_AGENT_NAME=docker-agent

# --- Tuning ---
# Workflows the agent runs in parallel
WOODPECKER_MAX_WORKFLOWS=2
