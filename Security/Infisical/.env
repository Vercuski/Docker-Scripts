# Infisical (secrets manager: projects, environments, secret versioning, .NET SDK and CLI) - uses the PostgreSQL and Redis stacks
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
INFISICAL_VERSION=v0.167.11
# Client image for the one-shot database setup (only psql is used)
INFISICAL_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# Web UI + API (8080 is CockroachDB)
INFISICAL_PORT=8138

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
INFISICAL_DB_INIT_IP=172.20.17.50
INFISICAL_IP=172.20.17.51
INFISICAL_INIT_IP=172.20.17.52

# --- Credentials & settings ---
# First administrator and organization, created by infisical-init on the first start
INFISICAL_ADMIN_EMAIL=admin@example.com
INFISICAL_ADMIN_PASSWORD=Password123
INFISICAL_ORGANIZATION=Local Dev
# Encrypts all stored secrets (16 bytes, 32 hex characters). Changing it makes existing secrets unreadable.
INFISICAL_ENCRYPTION_KEY=42097e21e2594cf821d5f59aaa819e2c
# Signs login tokens (base64)
INFISICAL_AUTH_SECRET=+X/tp6YHL3p0cB67Kxz5gN3tW3O5HoFIJTFzgThuPhY=
# PostgreSQL stack superuser (used once to create the role and database)
INFISICAL_DB_ADMIN_USER=user@user.com
INFISICAL_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
INFISICAL_DB_NAME=infisical
INFISICAL_DB_USER=infisical
INFISICAL_DB_PASSWORD=Password123
# Redis stack password (Databases/Redis REDIS_PASSWORD) and database number
INFISICAL_REDIS_PASSWORD=Password123
INFISICAL_REDIS_DB=2
# Send anonymous usage data to Infisical
INFISICAL_TELEMETRY_ENABLED=false
