# OpenBao (open-source Vault fork, MPL-2.0): persistent server that unseals and initializes itself
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
OPENBAO_VERSION=2.7.2

# --- Host ports ---
# API + web UI (8200 is Vault)
OPENBAO_PORT=8202

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
OPENBAO_IP=172.20.17.20

# --- Credentials & settings ---
# Static auto-unseal key: 32 bytes as 64 hex characters (openssl rand -hex 32). It encrypts the root key, so
# changing it after the first start leaves the data unreadable. Local development only.
OPENBAO_UNSEAL_KEY=d42d9ee9bd1ac01fdbc0fb25a074229212234a6281fd5fd14b1ba3a3f6355a70
# Password for the "admin" user created by self-initialization on the first start (userpass auth, full-access policy)
OPENBAO_ADMIN_PASSWORD=Password123
OPENBAO_LOG_LEVEL=info
