# ZAP (OWASP Zed Attack Proxy / Checkmarx ZAP): web app security scanner, GUI in the browser plus proxy + API
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
ZAP_VERSION=2.17.0

# --- Host ports ---
# Intercepting proxy + REST API of the headless zap service (point a browser or HttpClient proxy here)
ZAP_PROXY_PORT=8140
# ZAP desktop UI in the browser (zap-ui service, profile "ui")
ZAP_UI_PORT=8139

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
ZAP_IP=172.20.17.40
ZAP_UI_IP=172.20.17.41

# --- Credentials & settings ---
# API key for http://localhost:8140/JSON/... (header X-ZAP-API-Key or ?apikey=)
ZAP_API_KEY=local-dev-zap-api-key
