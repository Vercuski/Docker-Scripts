# step-ca (Smallstep private certificate authority with an ACME server) - local HTTPS certificates for dev services
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
STEPCA_VERSION=0.30.2

# --- Host ports ---
# CA API + ACME directory (HTTPS; 9000 is SonarQube)
STEPCA_PORT=9003

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
STEPCA_IP=172.20.17.30

# --- Credentials & settings ---
# Used only on the first start (empty data folder) to create the root and intermediate CA
STEPCA_NAME=Docker-Scripts Local CA
# Names in the CA's own TLS certificate (comma-separated)
STEPCA_DNS_NAMES=step-ca,localhost
# Name of the password (JWK) provisioner; the ACME provisioner is called "acme"
STEPCA_PROVISIONER_NAME=admin
# Encrypts the CA keys and the provisioner key (also the provisioner password for `step ca certificate`)
STEPCA_PASSWORD=Password123
