# Terraform CLI + Gaia UI
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
TERRAFORM_VERSION=latest
GAIA_VERSION=latest
GAIA_RUNNER_VERSION=latest
# Gaia is tested against MongoDB 4.4
GAIA_MONGO_VERSION=4.4

# --- Host ports ---
# Host 8080 is used by CockroachDB
GAIA_PORT=8085

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
TERRAFORM_IP=192.168.16.50
GAIA_IP=192.168.16.51
GAIA_RUNNER_IP=192.168.16.52
GAIA_MONGO_IP=192.168.16.53

# --- Credentials & settings ---
TERRAFORM_TZ=America/New_York
GAIA_RUNNER_API_PASSWORD=123456
GAIA_MONGODB_URI=mongodb://gaia-mongo/gaia
GAIA_EXTERNAL_URL=http://gaia:8080
