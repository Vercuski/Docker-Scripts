# Semaphore UI (web UI and scheduler for Ansible, Terraform/OpenTofu, PowerShell and Bash) - database in the PostgreSQL stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
SEMAPHORE_VERSION=v2.20.24
# Client image for the one-shot database setup (only psql is used)
SEMAPHORE_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
SEMAPHORE_PORT=3004

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
SEMAPHORE_DB_INIT_IP=172.20.9.40
SEMAPHORE_IP=172.20.9.41

# --- Credentials & settings ---
# Administrator created on first start
SEMAPHORE_ADMIN_USER=admin
SEMAPHORE_ADMIN_PASSWORD=Password123
SEMAPHORE_ADMIN_EMAIL=admin@example.com
# Encrypts stored keys and secrets (base64 of 32 bytes). Keep it once data exists.
SEMAPHORE_ACCESS_KEY_ENCRYPTION=bG9jYWwtZGV2LXNlbWFwaG9yZS1lbmNyeXB0LTAwMDE=
# PostgreSQL stack superuser (used once to create the role and database)
SEMAPHORE_DB_ADMIN_USER=user@user.com
SEMAPHORE_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
SEMAPHORE_DB_NAME=semaphore
SEMAPHORE_DB_USER=semaphore
SEMAPHORE_DB_PASSWORD=Password123
