# Atlantis (Terraform / OpenTofu pull-request automation) wired to the Gitea stack
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
ATLANTIS_VERSION=v0.49.0

# --- Host ports ---
ATLANTIS_PORT=4141

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
ATLANTIS_INIT_IP=172.20.9.30
ATLANTIS_IP=172.20.9.31

# --- Credentials & settings ---
# YOUR Gitea admin account (created in Gitea's installer). Used by atlantis-init to create the bot user and its token.
ATLANTIS_GITEA_ADMIN_USER=gitea_admin
ATLANTIS_GITEA_ADMIN_PASSWORD=Password123
# Bot account Atlantis comments as (created automatically if missing)
ATLANTIS_GITEA_BOT_USER=atlantis
ATLANTIS_GITEA_BOT_PASSWORD=Password123
ATLANTIS_GITEA_BOT_EMAIL=atlantis@dev.localhost
# Gitea's host port (GITEA_HTTP_PORT in SourceControl/Gitea); clone URLs on it are fetched from gitea:3000 instead
ATLANTIS_GITEA_HOST_PORT=3001
# Secret to enter on each repository's webhook (Gitea > repo Settings > Webhooks)
ATLANTIS_WEBHOOK_SECRET=Password123
# Repositories Atlantis will act on, e.g. gitea:3000/infra/* ("*" = any repo whose webhook points here)
ATLANTIS_REPO_ALLOWLIST=*
# terraform | opentofu - downloaded on demand, versions follow required_version in each project
ATLANTIS_TF_DISTRIBUTION=terraform
