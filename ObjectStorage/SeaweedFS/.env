# SeaweedFS all-in-one ("weed mini": master, volume, filer, S3 gateway, admin UI)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
SEAWEEDFS_VERSION=4.54

# --- Host ports ---
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ADMIN_PORT=12535
# Filer UI / HTTP file API (8888 is JupyterLab)
SEAWEEDFS_FILER_PORT=8150
SEAWEEDFS_MASTER_PORT=9333

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
SEAWEEDFS_IP=172.20.25.20

# --- Credentials & settings ---
# S3 admin identity (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for your SDK)
SEAWEEDFS_ACCESS_KEY=admin
SEAWEEDFS_SECRET_KEY=Password123
# Admin UI login
SEAWEEDFS_ADMIN_USER=admin
SEAWEEDFS_ADMIN_PASSWORD=Password123
# Buckets created on start if missing (comma separated)
SEAWEEDFS_BUCKETS=dev-bucket
