# Garage (S3-compatible object store) single node + one-shot layout/key/bucket setup + community web UI
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
GARAGE_VERSION=v2.5.0
GARAGE_WEBUI_VERSION=1.1.0
# Runs init/garage-init.py (standard library only)
GARAGE_INIT_IMAGE=python:3.13-alpine

# --- Host ports ---
GARAGE_S3_PORT=3900
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
GARAGE_WEBUI_PORT=3909

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
GARAGE_IP=172.20.25.30
GARAGE_INIT_IP=172.20.25.31
GARAGE_WEBUI_IP=172.20.25.32

# --- Credentials & settings ---
# S3 access key imported by garage-init: id = "GK" + 24 hex characters, secret = 64 hex characters
GARAGE_ACCESS_KEY_ID=GK6d7662022c03a786ac8be692
GARAGE_SECRET_KEY=b023faab5141afc5bac2c975f74fd1bcc0ea0bb1bacb6bb75aac2715c2b96587
# Buckets created if missing (comma separated); the key gets read/write/owner on each
GARAGE_BUCKETS=dev-bucket
# Admin API bearer token (also used by the web UI)
GARAGE_ADMIN_TOKEN=local-dev-garage-admin-token
GARAGE_METRICS_TOKEN=local-dev-garage-metrics-token
# Cluster secret: 64 hex characters
GARAGE_RPC_SECRET=613c2feac8f6458546db6b69ccf16c26ac03c0eb22030e78c3e0b24312295b7d

# --- Tuning ---
# Capacity announced for this node in the layout (GB); only applied when the layout is first assigned
GARAGE_CAPACITY_GB=100
