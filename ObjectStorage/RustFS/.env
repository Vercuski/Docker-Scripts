# RustFS (S3-compatible object storage, MinIO drop-in) + one-shot bucket creation
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
RUSTFS_VERSION=1.0.6
RUSTFS_AWSCLI_VERSION=2.40.4

# --- Host ports ---
# S3 API (9000 is SonarQube)
RUSTFS_S3_PORT=9008
RUSTFS_CONSOLE_PORT=9009

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
RUSTFS_IP=172.20.25.10
RUSTFS_INIT_IP=172.20.25.11

# --- Credentials & settings ---
# Root credentials (S3 access key / secret key, also the console login)
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=Password123
RUSTFS_REGION=us-east-1
# Buckets created by rustfs-init if missing (comma separated)
RUSTFS_BUCKETS=dev-bucket
