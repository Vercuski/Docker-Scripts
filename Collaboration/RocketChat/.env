# Rocket.Chat with its own MongoDB 8.0 replica set; email to Mailpit
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
ROCKETCHAT_VERSION=9.0.0
# Major version - a data folder created by 8.0 can't be opened by an older major
ROCKETCHAT_MONGO_VERSION=8.0

# --- Host ports ---
ROCKETCHAT_PORT=3015

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
ROCKETCHAT_MONGO_IP=172.20.29.20
ROCKETCHAT_MONGO_INIT_IP=172.20.29.21
ROCKETCHAT_IP=172.20.29.22

# --- Credentials & settings ---
# Administrator created on an empty database (later changes: UI > My Account)
ROCKETCHAT_ADMIN_USER=admin
ROCKETCHAT_ADMIN_PASSWORD=Password123
ROCKETCHAT_ADMIN_EMAIL=admin@example.com
ROCKETCHAT_MAIL_FROM=rocketchat@example.com
