# Plane (Community Edition) - PostgreSQL and Redis stacks; own RabbitMQ 3.13 broker and RustFS for uploads
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# One tag for all makeplane/plane-* images (backend, frontend, space, admin, live, proxy)
PLANE_VERSION=v1.5.0
PLANE_RUSTFS_VERSION=1.0.6
# Celery broker - stay on 3.x (RabbitMQ 4.x refuses Celery's transient control queues)
PLANE_MQ_VERSION=3.13-alpine
# Client image for the one-shot database setup (only psql is used)
PLANE_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
PLANE_PORT=8156

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
PLANE_DB_INIT_IP=172.20.29.30
PLANE_MINIO_IP=172.20.29.31
PLANE_MIGRATOR_IP=172.20.29.32
PLANE_API_IP=172.20.29.33
PLANE_WORKER_IP=172.20.29.34
PLANE_BEAT_IP=172.20.29.35
PLANE_WEB_IP=172.20.29.36
PLANE_SPACE_IP=172.20.29.37
PLANE_ADMIN_IP=172.20.29.38
PLANE_LIVE_IP=172.20.29.39
PLANE_PROXY_IP=172.20.29.40
PLANE_INIT_IP=172.20.29.41
PLANE_MQ_IP=172.20.29.42

# --- Credentials & settings ---
# Instance admin created by plane-init on an empty database (logs in to the app and to /god-mode/)
PLANE_ADMIN_EMAIL=admin@example.com
PLANE_ADMIN_PASSWORD=Password123
PLANE_ADMIN_NAME=Admin
PLANE_INSTANCE_NAME=docker-scripts
PLANE_MAIL_FROM=Plane <plane@example.com>
# Django / live-server signing keys (local-dev values)
PLANE_SECRET_KEY=local-dev-plane-secret-key-change-me-0123456789
PLANE_LIVE_SECRET_KEY=local-dev-plane-live-secret-key
# PostgreSQL stack superuser (used once to create the role and database)
PLANE_DB_ADMIN_USER=user@user.com
PLANE_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
PLANE_DB_NAME=plane
PLANE_DB_USER=plane
PLANE_DB_PASSWORD=Password123
# Redis stack (password and database number; 2-5 are used by other stacks)
PLANE_REDIS_PASSWORD=Password123
PLANE_REDIS_DB=6
# Login of the stack's own RabbitMQ broker (plane-mq)
PLANE_MQ_USER=plane
PLANE_MQ_PASSWORD=Password123
# Keys of the stack's own S3 store (plane-minio)
PLANE_S3_ACCESS_KEY=plane
PLANE_S3_SECRET_KEY=Password123

# --- Tuning ---
# Max upload size in bytes
PLANE_FILE_SIZE_LIMIT=5242880
PLANE_GUNICORN_WORKERS=1
