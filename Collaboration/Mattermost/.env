# Mattermost Team Edition - database in the PostgreSQL stack, email to Mailpit
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
MATTERMOST_VERSION=12.1.0
# Client image for the one-shot database setup (only psql is used)
MATTERMOST_DB_INIT_IMAGE=postgres:18
MATTERMOST_CURL_IMAGE=curlimages/curl:8.23.0

# --- Host ports ---
MATTERMOST_PORT=8065

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
MATTERMOST_DB_INIT_IP=172.20.29.10
MATTERMOST_IP=172.20.29.11
MATTERMOST_INIT_IP=172.20.29.12

# --- Credentials & settings ---
# System admin and team created by mattermost-init on an empty database
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_PASSWORD=Password123
MATTERMOST_ADMIN_EMAIL=admin@example.com
MATTERMOST_TEAM=docker-scripts
MATTERMOST_MAIL_FROM=mattermost@example.com
MATTERMOST_TZ=America/New_York
MATTERMOST_LOG_LEVEL=INFO
# PostgreSQL stack superuser (used once to create the role and database)
MATTERMOST_DB_ADMIN_USER=user@user.com
MATTERMOST_DB_ADMIN_PASSWORD=Password123
# Dedicated database and role
MATTERMOST_DB_NAME=mattermost
MATTERMOST_DB_USER=mattermost
MATTERMOST_DB_PASSWORD=Password123
