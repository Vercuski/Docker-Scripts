# Milvus standalone (etcd + MinIO + Milvus)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
MILVUS_ETCD_VERSION=v3.5.18
MILVUS_MINIO_VERSION=RELEASE.2024-05-28T17-19-04Z
MILVUS_VERSION=v2.5.27

# --- Host ports ---
MILVUS_MINIO_CONSOLE_PORT=9111
MILVUS_MINIO_API_PORT=9110
# gRPC
MILVUS_PORT=19530
# Health / metrics
MILVUS_METRICS_PORT=9091

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
MILVUS_ETCD_IP=192.168.16.40
MILVUS_MINIO_IP=192.168.16.41
MILVUS_IP=192.168.16.42

# --- Credentials & settings ---
# Milvus itself expects minioadmin/minioadmin unless you also change milvus.yaml
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin
MILVUS_MINIO_REGION=us-east-1

# --- Tuning ---
MILVUS_ETCD_AUTO_COMPACTION_RETENTION=1000
MILVUS_ETCD_QUOTA_BACKEND_BYTES=4294967296
MILVUS_ETCD_SNAPSHOT_COUNT=50000
