# CloudBeaver (DBeaver's web SQL client) with connections to the other database stacks pre-configured
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
CLOUDBEAVER_VERSION=26.2.5

# --- Host ports ---
CLOUDBEAVER_PORT=8978

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
CLOUDBEAVER_IP=172.20.6.230

# --- Credentials & settings ---
# Administrator created on first start (password policy: 8+ chars, mixed case, a digit)
CLOUDBEAVER_ADMIN_USER=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=Password123
CLOUDBEAVER_SERVER_NAME=Local Dev CloudBeaver
