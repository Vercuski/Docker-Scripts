# EventStoreDB
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
EVENTSTORE_VERSION=20.10.2-buster-slim

# --- Host ports ---
# External TCP (legacy clients)
EVENTSTORE_TCP_PORT=1113
# HTTP / gRPC / admin UI
EVENTSTORE_HTTP_PORT=2113

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
EVENTSTORE_IP=192.168.16.21

# --- Credentials & settings ---
# None | System | All
EVENTSTORE_RUN_PROJECTIONS=All
EVENTSTORE_START_STANDARD_PROJECTIONS=true
EVENTSTORE_ENABLE_ATOM_PUB_OVER_HTTP=true
