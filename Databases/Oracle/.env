# Oracle Database (Enterprise)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
ORACLE_VERSION=latest

# --- Host ports ---
ORACLE_PORT=1521

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
ORACLE_IP=192.168.16.25

# --- Credentials & settings ---
ORACLE_SID=ORCLCDB
ORACLE_PDB=ORCLPDB1
# SYS/SYSTEM/PDBADMIN password - only applied when the database is first created
ORACLE_PWD=Password123
