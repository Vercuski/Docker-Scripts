# MySQL + phpMyAdmin
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
MYSQL_VERSION=latest
PHPMYADMIN_VERSION=latest

# --- Host ports ---
MYSQL_PORT=3306
PHPMYADMIN_PORT=8082

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
MYSQL_IP=192.168.16.15
PHPMYADMIN_IP=192.168.16.20

# --- Credentials & settings ---
# Initial database/users - only applied when the data folder is empty
MYSQL_DATABASE=db
MYSQL_USER=user
MYSQL_PASSWORD=Password123
MYSQL_ROOT_PASSWORD=Password123
