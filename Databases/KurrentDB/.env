# KurrentDB (formerly EventStoreDB) - event-sourcing database
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
KURRENTDB_VERSION=26.2

# --- Host ports ---
# gRPC clients + HTTP API + admin UI (the legacy TCP port 1113 no longer exists)
KURRENTDB_HTTP_PORT=2113

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
KURRENTDB_IP=172.20.6.40

# --- Credentials & settings ---
# None | System | All
KURRENTDB_RUN_PROJECTIONS=All
KURRENTDB_START_STANDARD_PROJECTIONS=true
KURRENTDB_ENABLE_ATOM_PUB_OVER_HTTP=true
