# MariaDB + Adminer
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
MARIADB_VERSION=latest
ADMINER_VERSION=latest

# --- Host ports ---
# Host 3306 is used by MySQL
MARIADB_PORT=3307
ADMINER_PORT=8087

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
MARIADB_IP=192.168.16.22
ADMINER_IP=192.168.16.23

# --- Credentials & settings ---
# Credentials - only applied when the data folder is empty
MARIADB_ROOT_PASSWORD=Password123
MARIADB_USER=user
MARIADB_PASSWORD=Password123
ADMINER_DEFAULT_SERVER=mariadb
