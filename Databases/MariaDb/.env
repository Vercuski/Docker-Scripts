# MariaDB + Adminer
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
MARIADB_VERSION=latest
ADMINER_VERSION=latest

# --- Host ports ---
# Host 3306 is used by MySQL
MARIADB_PORT=3307
ADMINER_PORT=8087

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
MARIADB_IP=172.20.6.60
ADMINER_IP=172.20.6.61

# --- Credentials & settings ---
# Credentials - only applied when the data folder is empty
MARIADB_ROOT_PASSWORD=Password123
MARIADB_USER=user
MARIADB_PASSWORD=Password123
ADMINER_DEFAULT_SERVER=mariadb
