# RavenDB (.NET-native document database, unsecured single-node dev setup)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
RAVENDB_VERSION=7.2-latest

# --- Host ports ---
# HTTP API + RavenDB Studio. The container listens on the same port (the server calls itself on
# http://localhost:<port>), so containers on GroupNetwork use http://ravendb:8105.
RAVENDB_HTTP_PORT=8105
# Node-to-node TCP (replication, subscriptions)
RAVENDB_TCP_PORT=38888

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
RAVENDB_IP=172.20.6.160

# --- Credentials & settings ---
# Free Developer licence JSON (from ravendb.net/buy). Empty = the built-in community/eval licence.
RAVENDB_LICENSE=
