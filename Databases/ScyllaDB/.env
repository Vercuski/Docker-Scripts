# ScyllaDB (C++ rewrite of Cassandra: CQL compatible, plus the DynamoDB-compatible Alternator API)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
SCYLLA_VERSION=2026.3

# --- Host ports ---
# CQL (9042 is used by the Cassandra stack)
SCYLLA_CQL_PORT=9043
# Alternator (DynamoDB API) - point the AWS SDK's ServiceURL here
SCYLLA_ALTERNATOR_PORT=8106

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
SCYLLA_IP=172.20.6.220

# --- Tuning ---
# CPU shards and memory reserved by the server (developer mode, shares the CPU with other containers)
SCYLLA_SMP=1
SCYLLA_MEMORY=1G
