# Memcached (in-memory key/value cache, no persistence)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
MEMCACHED_VERSION=1.6-alpine

# --- Host ports ---
MEMCACHED_PORT=11211

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
MEMCACHED_IP=172.20.6.200

# --- Tuning ---
# Cache size in MB
MEMCACHED_MEMORY_MB=256
MEMCACHED_MAX_CONNECTIONS=1024
