# Prometheus + node-exporter + Alertmanager
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
PROMETHEUS_VERSION=latest
NODE_EXPORTER_VERSION=latest
ALERTMANAGER_VERSION=latest

# --- Host ports ---
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100
ALERTMANAGER_PORT=9093

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
PROMETHEUS_IP=192.168.16.26
NODE_EXPORTER_IP=192.168.16.27
ALERTMANAGER_IP=192.168.16.28
