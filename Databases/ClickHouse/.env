# ClickHouse
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
CLICKHOUSE_VERSION=latest

# --- Host ports ---
# HTTP interface
CLICKHOUSE_HTTP_PORT=8123
# Native client protocol (host 9000 is used by SonarQube)
CLICKHOUSE_NATIVE_PORT=19000

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
CLICKHOUSE_IP=192.168.16.29

# --- Credentials & settings ---
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=Password123
CLICKHOUSE_DB=default_db

# --- Tuning ---
# Open-file ulimit (soft and hard)
CLICKHOUSE_NOFILE_LIMIT=262144
