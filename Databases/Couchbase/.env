# Couchbase Server Community Edition (JSON document store + key/value cache + SQL++ queries + full-text search)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
COUCHBASE_VERSION=community-8.0.2

# --- Host ports ---
# 8091-8096 are used by other stacks, so the HTTP services are remapped. couchbase-init publishes these as the
# node's "external" alternate addresses, so SDKs connecting to couchbase://localhost find them automatically.
# Web console + cluster manager (container 8091)
COUCHBASE_MGMT_PORT=8107
# Views (container 8092)
COUCHBASE_VIEWS_PORT=8108
# SQL++ query service (container 8093)
COUCHBASE_QUERY_PORT=8109
# Full-text search (container 8094)
COUCHBASE_SEARCH_PORT=8110
# Key/value data service (container 11210)
COUCHBASE_KV_PORT=11210

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
COUCHBASE_IP=172.20.6.180
COUCHBASE_INIT_IP=172.20.6.181

# --- Credentials & settings ---
COUCHBASE_USER=Administrator
COUCHBASE_PASSWORD=Password123
# Bucket created on first start
COUCHBASE_BUCKET=dev

# --- Tuning ---
# Memory quotas in MB
COUCHBASE_DATA_RAM_MB=512
COUCHBASE_INDEX_RAM_MB=256
COUCHBASE_SEARCH_RAM_MB=256
COUCHBASE_BUCKET_RAM_MB=256
