# InfluxDB 2
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Keep on 2.x - the DOCKER_INFLUXDB_INIT_* variables do not apply to InfluxDB 3
INFLUXDB_VERSION=2

# --- Host ports ---
INFLUXDB_PORT=8086

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
INFLUXDB_IP=192.168.16.12

# --- Credentials & settings ---
# Initial setup - only applied when the data folder is empty
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=user
INFLUXDB_INIT_PASSWORD=Password123
INFLUXDB_INIT_ORG=HomeServer
INFLUXDB_INIT_BUCKET=Home
INFLUXDB_INIT_RETENTION=1w
INFLUXDB_INIT_ADMIN_TOKEN=API_TOKEN
