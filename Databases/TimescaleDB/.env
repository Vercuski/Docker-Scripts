# TimescaleDB (PostgreSQL 18 with the TimescaleDB time-series extension)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Pinned to the PostgreSQL major version: a different major needs pg_upgrade on existing data
TIMESCALEDB_VERSION=2.32.0-pg18

# --- Host ports ---
# 5432 is used by the PostgreSQL stack
TIMESCALEDB_PORT=5433

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
TIMESCALEDB_IP=172.20.6.240

# --- Credentials & settings ---
TIMESCALEDB_USER=user@user.com
TIMESCALEDB_PASSWORD=Password123
TIMESCALEDB_DB=tsdb
