# PostgreSQL + pgAdmin 4
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Major version - changing it on existing data requires pg_upgrade
# PostgreSQL 18 with pgvector (tag = pg<major>-trixie, or e.g. 0.8.7-pg18-trixie to pin pgvector too)
PGVECTOR_VERSION=pg18-trixie
PGADMIN_VERSION=latest

# --- Host ports ---
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
POSTGRES_IP=172.20.6.130
PGADMIN_IP=172.20.6.131

# --- Credentials & settings ---
# Superuser - only applied when the data folder is empty
POSTGRES_USER=user@user.com
POSTGRES_PASSWORD=Password123
# pgAdmin web login
PGADMIN_EMAIL=user@user.com
PGADMIN_PASSWORD=Password123

# --- Tuning ---
# Docker log rotation for the postgres container
POSTGRES_LOG_MAX_SIZE=10m
POSTGRES_LOG_MAX_FILE=3
