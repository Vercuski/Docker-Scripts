# PostgreSQL + pgAdmin 4
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Major version - changing it on existing data requires pg_upgrade
POSTGRES_VERSION=18
PGADMIN_VERSION=latest

# --- Host ports ---
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
POSTGRES_IP=192.168.16.17
PGADMIN_IP=192.168.16.18

# --- Credentials & settings ---
# Superuser - only applied when the data folder is empty
POSTGRES_USER=user@user.com
POSTGRES_PASSWORD=Password123
# pgAdmin web login
PGADMIN_EMAIL=user@user.com
PGADMIN_PASSWORD=Password123

# --- Tuning ---
# Docker log rotation for the postgres container
POSTGRES_LOG_MAX_SIZE=10m
POSTGRES_LOG_MAX_FILE=3
