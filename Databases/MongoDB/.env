# MongoDB + mongo-express
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
MONGO_VERSION=latest
MONGO_EXPRESS_VERSION=latest

# --- Host ports ---
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8088

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
MONGO_IP=192.168.16.13
MONGO_EXPRESS_IP=192.168.16.24

# --- Credentials & settings ---
# Root user - only applied when the data folder is empty
MONGO_ROOT_USERNAME=user
MONGO_ROOT_PASSWORD=Password123
# mongo-express web login
MONGO_EXPRESS_USERNAME=user
MONGO_EXPRESS_PASSWORD=Password123
