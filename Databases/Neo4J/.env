# Neo4j
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
NEO4J_VERSION=latest

# --- Host ports ---
# Neo4j Browser (HTTP)
NEO4J_HTTP_PORT=7474
NEO4J_HTTPS_PORT=7473
# Bolt (application connections)
NEO4J_BOLT_PORT=7687

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
NEO4J_IP=192.168.16.16

# --- Credentials & settings ---
# Password for the 'neo4j' user - only applied when the data folder is empty
NEO4J_PASSWORD=Password123
# JSON array, e.g. ["apoc","graph-data-science"]
NEO4J_PLUGINS='["apoc"]'
NEO4J_PROCEDURES_UNRESTRICTED=apoc.*
NEO4J_APOC_IMPORT_FILE_ENABLED=true
NEO4J_APOC_EXPORT_FILE_ENABLED=true
