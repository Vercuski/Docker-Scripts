# authentik (server + worker, uses the PostgreSQL stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
AUTHENTIK_VERSION=2026.8.5
# Only used by the one-shot database setup container (psql client)
AUTHENTIK_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
AUTHENTIK_HTTP_PORT=8290
AUTHENTIK_HTTPS_PORT=8445

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
AUTHENTIK_DB_INIT_IP=172.20.2.30
AUTHENTIK_SERVER_IP=172.20.2.31
AUTHENTIK_WORKER_IP=172.20.2.32

# --- Credentials & settings ---
# Login for the PostgreSQL stack; the "authentik" database is created on first start
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=user@user.com
AUTHENTIK_DB_PASSWORD=Password123
# Signs cookies and tokens. Changing it logs everyone out. Local-dev value only.
AUTHENTIK_SECRET_KEY=LocalDevOnly-authentik-secret-key-change-me-0123456789abcdef
# Initial admin "akadmin" - only applied when the database is empty
AUTHENTIK_BOOTSTRAP_PASSWORD=Password123
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
# API token for akadmin (Authorization: Bearer <token>) - only applied when the database is empty
AUTHENTIK_BOOTSTRAP_TOKEN=LocalDevOnly-authentik-api-token
# Outgoing mail goes to the Email/Mailpit stack
AUTHENTIK_EMAIL_HOST=mailpit
AUTHENTIK_EMAIL_PORT=1025
AUTHENTIK_EMAIL_FROM=authentik@localhost
