# Keycloak (dev mode, uses the PostgreSQL stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# --- Image versions ---
KEYCLOAK_VERSION=26.7

# --- Host ports ---
KEYCLOAK_PORT=8280
KEYCLOAK_MANAGEMENT_PORT=9001

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
KEYCLOAK_IP=192.168.16.212

# --- Credentials & settings ---
# Temporary bootstrap admin - only created when the database is empty
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=Password123
# postgres | mssql | mysql | mariadb | dev-file (dev-file needs no external database, data is lost with the container)
KEYCLOAK_DB_VENDOR=postgres
# SQL Server alternative: KEYCLOAK_DB_VENDOR=mssql, jdbc:sqlserver://mssqldb:1433;databaseName=keycloak;encrypt=false
KEYCLOAK_DB_URL=jdbc:postgresql://postgresql:5432/keycloak
KEYCLOAK_DB_USERNAME=user@user.com
KEYCLOAK_DB_PASSWORD=Password123
KEYCLOAK_LOG_LEVEL=info
