# Authelia (SSO portal, forward-auth for reverse proxies, small OIDC provider)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
AUTHELIA_VERSION=4.39

# --- Host ports ---
# Portal (HTTPS): https://auth.dev.localhost:9095 (9091 is used by Milvus)
AUTHELIA_PORT=9095

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
AUTHELIA_INIT_IP=172.20.2.50
AUTHELIA_IP=172.20.2.51

# --- Credentials & settings ---
# Session cookie domain. Must contain a dot; *.localhost names resolve to your machine in browsers.
# Protected apps and the portal (auth.<domain>) must be subdomains of it.
AUTHELIA_COOKIE_DOMAIN=dev.localhost
# Local-dev secrets (at least 20 characters each). Changing the storage key makes the existing database unreadable.
AUTHELIA_SESSION_SECRET=LocalDevOnly-authelia-session-secret-0123456789
AUTHELIA_STORAGE_ENCRYPTION_KEY=LocalDevOnly-authelia-storage-key-0123456789
AUTHELIA_JWT_SECRET=LocalDevOnly-authelia-jwt-secret-0123456789
AUTHELIA_OIDC_HMAC_SECRET=LocalDevOnly-authelia-oidc-hmac-secret-0123456789
