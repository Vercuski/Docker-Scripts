# SuperTokens Core (uses the PostgreSQL stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders (see CreateVolumes.bat / .sh)
ROOT_VOLUME_DIR=D:

# --- Image versions ---
SUPERTOKENS_VERSION=9.3

# --- Host ports ---
SUPERTOKENS_PORT=3567

# --- Network (static IPs on GroupNetwork 192.168.16.0/24) ---
SUPERTOKENS_IP=192.168.16.211

# --- Credentials & settings ---
# URL-encode special characters in the user name/password (@ -> %40)
SUPERTOKENS_DB_URI=postgresql://user%40user.com:Password123@postgresql:5432/supertokens
