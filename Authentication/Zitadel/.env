# ZITADEL v4 (API/console + Login V2 UI, uses the PostgreSQL stack)
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# zitadel and zitadel-login are released together with the same tag
ZITADEL_VERSION=v4.20.3
# Only used by the one-shot database setup container (psql client)
ZITADEL_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# API, console and OIDC endpoints. Also baked into issued URLs, so change it here rather than remapping.
ZITADEL_PORT=8300
# Login V2 UI
ZITADEL_LOGIN_PORT=8301

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
ZITADEL_DB_INIT_IP=172.20.2.40
# The login container shares this IP (network_mode: service:zitadel)
ZITADEL_IP=172.20.2.41

# --- Credentials & settings ---
# Login for the PostgreSQL stack; the "zitadel" database is created on first start
ZITADEL_DB_NAME=zitadel
ZITADEL_DB_USER=user@user.com
ZITADEL_DB_PASSWORD=Password123
# Encrypts secrets in the database. Exactly 32 characters, and it can't change once data exists.
ZITADEL_MASTERKEY=LocalDevOnlyMasterkey32Chars0000
# Signs the Login UI session cookie (32+ characters)
ZITADEL_LOGIN_COOKIE_SECRET=LocalDevOnly-zitadel-login-cookie-secret
# First admin - only applied when the database is empty. The login name is <username>@zitadel.localhost.
# ZITADEL's password policy needs upper and lower case, a number and a symbol, hence the "!".
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=Password123!
