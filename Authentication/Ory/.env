# Ory Kratos (identities, login, registration) + Ory Hydra (OAuth2 / OpenID Connect) + self-service UI
# Every setting below overrides a ${VAR:-default} in docker-compose.yml.
# Remove a line to fall back to the compose default.

# Host root for the bind-mounted volume folders. Set once per machine by CreateVolumes.bat / .sh
# (Windows default D:, Linux/macOS default $HOME). Uncomment only to override it for this stack.
# ROOT_VOLUME_DIR=D:

# --- Image versions ---
# Kratos, Hydra and the UI are released together with the same version
ORY_VERSION=v26.2.0
# Only used by the one-shot database setup container (psql client)
ORY_DB_INIT_IMAGE=postgres:18

# --- Host ports ---
# Browser-facing URLs in kratos/kratos.yml and hydra/hydra.yml use these values: change them there too.
KRATOS_PUBLIC_PORT=4433
KRATOS_ADMIN_PORT=4434
HYDRA_PUBLIC_PORT=4444
HYDRA_ADMIN_PORT=4445
ORY_UI_PORT=4455

# --- Network (static IPs on GroupNetwork 172.20.0.0/16) ---
ORY_DB_INIT_IP=172.20.2.60
KRATOS_MIGRATE_IP=172.20.2.61
KRATOS_IP=172.20.2.62
HYDRA_MIGRATE_IP=172.20.2.63
HYDRA_IP=172.20.2.64
ORY_UI_IP=172.20.2.65

# --- Credentials & settings ---
# Login for the PostgreSQL stack; the kratos and hydra databases are created on first start
ORY_DB_USER=user@user.com
ORY_DB_PASSWORD=Password123
# Connection strings: same login, with @ in the user name written as %40
KRATOS_DSN=postgres://user%40user.com:Password123@postgresql:5432/kratos?sslmode=disable
HYDRA_DSN=postgres://user%40user.com:Password123@postgresql:5432/hydra?sslmode=disable
# Local-dev secrets. KRATOS_CIPHER_SECRET must be exactly 32 characters.
KRATOS_COOKIE_SECRET=LocalDevOnly-kratos-cookie-secret
KRATOS_CIPHER_SECRET=LocalDevOnlyKratosCipher32Chars0
HYDRA_SYSTEM_SECRET=LocalDevOnly-hydra-system-secret
ORY_UI_COOKIE_SECRET=LocalDevOnly-ui-cookie-secret
ORY_UI_CSRF_SECRET=LocalDevOnly-ui-csrf-secret
# Verification and recovery mails go to the Email/Mailpit stack
KRATOS_SMTP_URI=smtp://mailpit:1025/?disable_starttls=true
KRATOS_SMTP_FROM=kratos@localhost
